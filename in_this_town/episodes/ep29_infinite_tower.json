 "lines": [
  {
   "text": "Eli had been climbing the tower for three hours.",
   "tag": "[calm]",
   "pause": 0.14
  },
  {
   "text": "But every time he looked down, the ground was farther away.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "Only colored platforms, floating above an endless black void.",
   "tag": "[mysterious]",
   "pause": 0.22
  },
  {
   "text": "“Is it still Tuesday?”",
   "speak": "Is it still Tuesday?",
   "voice": "girl",
   "tag": "[softly]",
   "pause": 0.22
  },
  {
   "text": "“Fresh coat. Same as last time.”",
   "speak": "Fresh coat. Same as last time.",
   "voice": "painter",
   "tag": "[flatly]",
   "pause": 0.22
  },
  {
   "text": "“Keep count, kid.”",
   "speak": "Keep count, kid.",
   "voice": "old",
   "tag": "[quietly]",
   "pause": 0.23
  },
  {
   "text": "At level fifty, a message was scratched into the wall.",
   "tag": "[calm]",
   "pause": 0.14
  },
  {
   "text": "“STOP COUNTING.”",
   "speak": "Stop counting.",
   "tag": "[whispers]",
   "pause": 0.19
  },
  {
   "text": "He ignored it.",
   "tag": "[calm]",
   "pause": 0.22
  },
  {
   "text": "At level seventy, the platforms stopped moving.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "So did everyone on them.",
   "tag": "[softly]",
   "pause": 0.24
  },
  {
   "text": "At level ninety, he heard footsteps above him.",
   "tag": "[mysterious]",
   "pause": 0.14
  },
  {
   "text": "But no one had climbed this high.",
   "tag": "[softly]",
   "pause": 0.22
  },
  {
   "text": "Finally, level one hundred.",
   "tag": "[calm]",
   "pause": 0.13
  },
  {
   "text": "There was a white door.",
   "tag": "[mysterious]",
   "pause": 0.1
  },
  {
   "text": "He opened it.",
   "tag": "[softly]",
   "pause": 0.24
  },
  {
   "text": "Behind it was the same tower.",
   "tag": "[calm]",
   "pause": 0.1
  },
  {
   "text": "But everything was upside down.",
   "tag": "[softly]",
   "pause": 0.26
  },
  {
   "text": "Someone was climbing toward him.",
   "tag": "[mysterious]",
   "pause": 0.13
  },
  {
   "text": "A boy wearing the exact same clothes.",
   "tag": "[softly]",
   "pause": 0.2
  },
  {
   "text": "He stopped, and pointed behind Eli.",
   "tag": "[calm]",
   "pause": 0.22
  },
  {
   "text": "On the wall were hundreds of tally marks.",
   "tag": "[mysterious]",
   "pause": 0.14
  },
  {
   "text": "“YOU HAVE REACHED THE TOP 416 TIMES.”",
   "speak": "You have reached the top, four hundred sixteen times.",
   "tag": "[softly]",
   "pause": 0.22
  },
  {
   "text": "Eli stepped backward.",
   "tag": "[calm]",
   "pause": 0.09
  },
  {
   "text": "The door slammed shut.",
   "tag": "[calm]",
   "pause": 0.23
  },
  {
   "text": "“Attempt 417 begins now.”",
   "speak": "Attempt four seventeen begins now.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.22,
   "fx": "pa"
  },
  {
   "text": "And the floor disappeared.",
   "tag": "[softly]",
   "pause": 0.14
  }
 ],
