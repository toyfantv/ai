 "lines": [
  {
   "text": "Sadie entered the shopping mall at 4:45 PM.",
   "speak": "Sadie entered the shopping mall at four forty-five P M.",
   "tag": "[calm]",
   "pause": 0.09
  },
  {
   "text": "When she checked her phone, it was still 4:45.",
   "speak": "When she checked her phone, it was still four forty-five.",
   "tag": "[mysterious]",
   "pause": 0.11
  },
  {
   "text": "The mall was completely empty.",
   "tag": "[calm]",
   "pause": 0.08
  },
  {
   "text": "Every store was open.",
   "tag": "[calm]",
   "pause": 0.05
  },
  {
   "text": "Every light was on.",
   "tag": "[calm]",
   "pause": 0.06
  },
  {
   "text": "But no employees.",
   "tag": "[softly]",
   "pause": 0.05
  },
  {
   "text": "No customers.",
   "tag": "[softly]",
   "pause": 0.05
  },
  {
   "text": "And no music.",
   "tag": "[softly]",
   "pause": 0.13
  },
  {
   "text": "Sadie walked toward the exit.",
   "tag": "[calm]",
   "pause": 0.06
  },
  {
   "text": "The automatic doors opened.",
   "tag": "[calm]",
   "pause": 0.09
  },
  {
   "text": "Behind them was another shopping mall.",
   "tag": "[mysterious]",
   "pause": 0.09
  },
  {
   "text": "Exactly the same.",
   "tag": "[softly]",
   "pause": 0.13
  },
  {
   "text": "She turned around.",
   "tag": "[calm]",
   "pause": 0.06
  },
  {
   "text": "The first mall had disappeared.",
   "tag": "[mysterious]",
   "pause": 0.13
  },
  {
   "text": "“What time do you have?”",
   "speak": "What time do you have?",
   "voice": "dana",
   "tag": "[quietly]",
   "pause": 0.05
  },
  {
   "text": "“4:45.”",
   "speak": "Four forty-five.",
   "voice": "sadie",
   "tag": "[nervously]",
   "pause": 0.05
  },
  {
   "text": "“Still?”",
   "speak": "Still?",
   "voice": "dana",
   "tag": "[flatly]",
   "pause": 0.09
  },
  {
   "text": "“You are here.”",
   "speak": "You are here.",
   "voice": "guard",
   "tag": "[flatly]",
   "pause": 0.09
  },
  {
   "text": "“Attention shoppers. Please remain where you are.”",
   "speak": "Attention shoppers. Please remain where you are.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.1,
   "fx": "pa"
  },
  {
   "text": "A distant escalator began moving.",
   "tag": "[mysterious]",
   "pause": 0.08
  },
  {
   "text": "A person slowly rose into view.",
   "tag": "[calm]",
   "pause": 0.09
  },
  {
   "text": "They were standing perfectly still.",
   "tag": "[softly]",
   "pause": 0.05
  },
  {
   "text": "Facing backward.",
   "tag": "[softly]",
   "pause": 0.11
  },
  {
   "text": "Then another.",
   "tag": "[calm]",
   "pause": 0.05
  },
  {
   "text": "And another.",
   "tag": "[calm]",
   "pause": 0.08
  },
  {
   "text": "Every escalator was carrying motionless people.",
   "tag": "[mysterious]",
   "pause": 0.09
  },
  {
   "text": "“Store closing in five minutes.”",
   "speak": "Store closing in five minutes.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.09,
   "fx": "pa"
  },
  {
   "text": "Sadie checked her phone.",
   "tag": "[calm]",
   "pause": 0.06
  },
  {
   "text": "4:45 PM.",
   "speak": "Four forty-five P M.",
   "tag": "[softly]",
   "pause": 0.11
  },
  {
   "text": "Every person on the escalators turned toward her.",
   "tag": "[mysterious]",
   "pause": 0.1
  },
  {
   "text": "The lights dimmed.",
   "tag": "[softly]",
   "pause": 0.09
  },
  {
   "text": "“Thank you for shopping with us.”",
   "speak": "Thank you for shopping with us.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.13,
   "fx": "pa"
  },
  {
   "text": "“Your replacement has arrived.”",
   "speak": "Your replacement has arrived.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.18,
   "fx": "pa"
  },
  {
   "text": "Across the mall, someone wearing Sadie's clothes stepped through the entrance.",
   "tag": "[mysterious]",
   "pause": 0.09
  }
 ],
