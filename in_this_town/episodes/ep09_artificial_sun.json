 "lines": [
  {
   "text": "In this town, the sun never sets.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "It's always exactly noon.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "The sky is always blue.",
   "tag": "[calm]",
   "pause": 0.32
  },
  {
   "text": "And nobody has ever seen nighttime.",
   "tag": "[mysterious]",
   "pause": 0.5
  },
  {
   "text": "But one day, a boy named Lucas noticed something strange.",
   "tag": "[curious]",
   "pause": 0.4
  },
  {
   "text": "The sun blinked.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "Just for a second.",
   "tag": "[quietly]",
   "pause": 0.4
  },
  {
   "text": "He thought he imagined it.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "Until it happened again.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "This time, the entire sky went black.",
   "tag": "[dramatic]",
   "pause": 0.4
  },
  {
   "text": "For one second, Lucas saw thousands of stars.",
   "tag": "[in awe]",
   "pause": 0.32
  },
  {
   "text": "And something enormous standing behind the sun.",
   "tag": "[fearful]",
   "pause": 0.6
  },
  {
   "text": "The next morning, Lucas climbed the tallest building in town.",
   "tag": "[determined]",
   "pause": 0.32
  },
  {
   "text": "He pointed a telescope toward the sky.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "And discovered the truth.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "The sun wasn't a sun.",
   "tag": "[shocked]",
   "pause": 0.32
  },
  {
   "text": "It was a giant lightbulb.",
   "tag": "[shocked]",
   "pause": 0.32
  },
  {
   "text": "Hanging from an enormous ceiling.",
   "tag": "[fearful]",
   "pause": 0.5
  },
  {
   "text": "Suddenly, the lightbulb flickered.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "A gigantic hand reached down from above.",
   "tag": "[fearful]",
   "pause": 0.32
  },
  {
   "text": "And a voice echoed through the town.",
   "tag": "[whispers]",
   "pause": 0.5
  },
  {
   "text": "“WHO LEFT THE TOY CITY TURNED ON?”",
   "speak": "Who left the toy city turned on?",
   "voice": "giant",
   "tag": "[annoyed, loud]",
   "fx": "giant",
   "pause": 0.0
  }
 ],
