 "lines": [
  {
   "text": "Charlotte found a photograph slipped under her bedroom door.",
   "tag": "[calm]",
   "pause": 0.2
  },
  {
   "text": "It showed a mansion she'd never visited.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "In the upstairs window stood a girl.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "The girl looked exactly like Charlotte.",
   "tag": "[softly]",
   "pause": 0.27
  },
  {
   "text": "The next morning, another photograph arrived.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "This time, she stood closer to the window.",
   "tag": "[mysterious]",
   "pause": 0.2
  },
  {
   "text": "On the third day, the window was open.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "And the girl was gone.",
   "tag": "[softly]",
   "pause": 0.27
  },
  {
   "text": "That evening, she was invited to a party.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "The address matched the mansion.",
   "tag": "[mysterious]",
   "pause": 0.27
  },
  {
   "text": "When she arrived, the house was silent.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "Music played from an empty ballroom.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "Dinner was served at a table with twelve untouched plates.",
   "tag": "[calm]",
   "pause": 0.2
  },
  {
   "text": "Then she noticed photographs along the staircase.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "Each showed a different guest.",
   "tag": "[mysterious]",
   "pause": 0.15
  },
  {
   "text": "But every face had been scratched out.",
   "tag": "[softly]",
   "pause": 0.28
  },
  {
   "text": "At the top hung one final photograph.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "It showed Charlotte in the ballroom.",
   "tag": "[mysterious]",
   "pause": 0.15
  },
  {
   "text": "Surrounded by twelve people.",
   "tag": "[softly]",
   "pause": 0.27
  },
  {
   "text": "She turned around.",
   "tag": "[softly]",
   "pause": 0.15
  },
  {
   "text": "The room was still empty.",
   "tag": "[mysterious]",
   "pause": 0.28
  },
  {
   "text": "Then chairs scraped across the floor.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "One by one.",
   "tag": "[softly]",
   "pause": 0.28
  },
  {
   "text": "A voice whispered behind her,",
   "tag": "[softly]",
   "pause": 0.15
  },
  {
   "text": "“You're the last one we needed.”",
   "tag": "[whispers]",
   "pause": 0.4,
   "speak": "You're the last one we needed.",
   "voice": "guests",
   "fx": "whisper"
  },
  {
   "text": "Charlotte looked at the photograph again.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "Now thirteen people stood in it.",
   "tag": "[mysterious]",
   "pause": 0.2
  },
  {
   "text": "And none of them had faces.",
   "tag": "[whispers]",
   "pause": 0.15
  }
 ],
