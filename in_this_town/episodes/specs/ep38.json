 "lines": [
  {
   "text": "Eli found a video file on his computer.",
   "tag": "[mysterious]",
   "pause": 0.1
  },
  {
   "text": "It was titled, TOMORROW_3AM.",
   "tag": "[serious]",
   "pause": 0.25,
   "speak": "It was titled, tomorrow, three A M."
  },
  {
   "text": "He pressed play.",
   "tag": "[quietly]",
   "pause": 0.3
  },
  {
   "text": "It showed a hotel hallway.",
   "tag": "[mysterious]",
   "pause": 0.15
  },
  {
   "text": "A door slowly opened.",
   "tag": "[quietly]",
   "pause": 0.5
  },
  {
   "text": "And Eli walked out.",
   "tag": "[serious]",
   "pause": 0.25
  },
  {
   "text": "Covered in dust.",
   "tag": "[quietly]",
   "pause": 0.1
  },
  {
   "text": "And crying.",
   "tag": "[quietly]",
   "pause": 0.25
  },
  {
   "text": "The recording cut to black.",
   "tag": "[serious]",
   "pause": 0.4
  },
  {
   "text": "The next morning, Eli received a message.",
   "tag": "[mysterious]",
   "pause": 0.2
  },
  {
   "text": "“YOUR ROOM IS READY.”",
   "tag": "[whispers]",
   "pause": 0.15,
   "speak": "Your room is ready."
  },
  {
   "text": "Attached was a hotel address.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "He deleted it.",
   "tag": "[serious]",
   "pause": 0.35
  },
  {
   "text": "But that night, his bedroom door changed.",
   "tag": "[mysterious]",
   "pause": 0.2
  },
  {
   "text": "A brass number appeared.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "ROOM 013.",
   "tag": "[serious]",
   "pause": 0.2,
   "speak": "Room zero one three."
  },
  {
   "text": "Eli backed away.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "His computer started playing again.",
   "tag": "[urgent]",
   "pause": 0.15
  },
  {
   "text": "This time, the recording was different.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "It showed Eli in his bedroom, watching the computer.",
   "tag": "[quietly]",
   "pause": 0.3
  },
  {
   "text": "Then someone stepped out of the darkness behind him.",
   "tag": "[whispers]",
   "pause": 0.7
  },
  {
   "text": "Eli turned around.",
   "tag": "[urgent]",
   "pause": 0.2
  },
  {
   "text": "Nothing.",
   "tag": "[serious]",
   "pause": 0.4
  },
  {
   "text": "He looked back at the screen.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "The figure was closer.",
   "tag": "[serious]",
   "pause": 0.3
  },
  {
   "text": "Then closer again.",
   "tag": "[serious]",
   "pause": 0.35
  },
  {
   "text": "Until its face filled the recording.",
   "tag": "[whispers]",
   "pause": 0.7
  },
  {
   "text": "“Stop watching.”",
   "tag": "[whispers]",
   "pause": 0.4,
   "speak": "Stop watching.",
   "fx": "whisper",
   "voice": "computer"
  },
  {
   "text": "Eli slammed the laptop shut.",
   "tag": "[urgent]",
   "pause": 0.6
  },
  {
   "text": "From inside the closed screen came three slow knocks.",
   "tag": "[quietly]",
   "pause": 2.0
  },
  {
   "text": "Then the bedroom door began opening.",
   "tag": "[whispers]",
   "pause": 0.1
  }
 ],
