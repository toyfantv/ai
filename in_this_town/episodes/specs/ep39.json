 "lines": [
  {
   "text": "“Sophie, if you can hear me, don't answer.”",
   "speak": "Sophie, if you can hear me, don't answer.",
   "tag": "[urgent]",
   "voice": "worker",
   "fx": "radio",
   "pause": 0.2
  },
  {
   "text": "The last message Daniel received before entering the tunnel.",
   "tag": "[mysterious]",
   "pause": 0.1
  },
  {
   "text": "His sister had disappeared three days earlier.",
   "tag": "[serious]",
   "pause": 0.1
  },
  {
   "text": "The rescue team found only her flashlight.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "Still switched on.",
   "tag": "[quietly]",
   "pause": 0.35
  },
  {
   "text": "Daniel crawled deeper into the darkness.",
   "tag": "[mysterious]",
   "pause": 0.12
  },
  {
   "text": "The walls were wet.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "And something was breathing ahead of him.",
   "tag": "[quietly]",
   "pause": 0.4
  },
  {
   "text": "Then he heard Sophie's voice.",
   "tag": "[mysterious]",
   "pause": 0.12
  },
  {
   "text": "“Daniel? I'm trapped.”",
   "speak": "Daniel? I'm trapped.",
   "tag": "[scared, distant]",
   "voice": "sophie",
   "fx": "cave",
   "pause": 0.12
  },
  {
   "text": "“Sophie, I'm coming!”",
   "speak": "Sophie, I'm coming!",
   "tag": "[calling out]",
   "voice": "daniel",
   "fx": "cave",
   "pause": 0.12
  },
  {
   "text": "The tunnel grew narrower.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "Until he could barely move.",
   "tag": "[quietly]",
   "pause": 0.55
  },
  {
   "text": "His flashlight illuminated a face.",
   "tag": "[quietly]",
   "pause": 0.55
  },
  {
   "text": "Sophie.",
   "tag": "[whispers]",
   "pause": 0.2
  },
  {
   "text": "She was smiling.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "But her mouth was moving in the wrong direction.",
   "tag": "[serious]",
   "pause": 0.2
  },
  {
   "text": "Daniel scrambled backward.",
   "tag": "[serious]",
   "pause": 0.4
  },
  {
   "text": "The thing lunged.",
   "tag": "[serious]",
   "pause": 0.1
  },
  {
   "text": "He kicked it away and crawled toward the entrance.",
   "tag": "[urgent]",
   "pause": 0.08
  },
  {
   "text": "Behind him, dozens of voices began screaming his name.",
   "tag": "[serious]",
   "pause": 0.15
  },
  {
   "text": "He reached daylight.",
   "tag": "[relieved]",
   "pause": 0.1
  },
  {
   "text": "A rescue worker pulled him out.",
   "tag": "[mysterious]",
   "pause": 0.12
  },
  {
   "text": "“Did you find your sister?”",
   "speak": "Did you find your sister?",
   "tag": "[gently]",
   "voice": "worker",
   "pause": 0.15
  },
  {
   "text": "Daniel shook his head.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "Then his radio crackled.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "Sophie's real voice.",
   "tag": "[quietly]",
   "pause": 0.1
  },
  {
   "text": "“Daniel, I'm still inside.”",
   "speak": "Daniel, I'm still inside.",
   "tag": "[whispers]",
   "voice": "sophie",
   "fx": "radio",
   "pause": 0.3
  },
  {
   "text": "He stared at the worker.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "The worker slowly smiled.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "And answered in Daniel's voice,",
   "tag": "[mysterious]",
   "pause": 0.25
  },
  {
   "text": "“So am I.”",
   "speak": "So am I.",
   "tag": "[calm, quietly]",
   "voice": "daniel",
   "fx": "mimic",
   "pause": 0.2
  }
 ],
 "samples": {
