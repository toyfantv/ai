 "lines": [
  {
   "text": "Every midnight, two people are summoned to the abandoned arena.",
   "tag": "[mysterious]",
   "pause": 0.055
  },
  {
   "text": "Only one is allowed to leave.",
   "tag": "[serious]",
   "pause": 0.095
  },
  {
   "text": "Tonight, Quinn was chosen.",
   "tag": "[softly]",
   "pause": 0.055
  },
  {
   "text": "When she entered, the seats were empty.",
   "tag": "[mysterious]",
   "pause": 0.04
  },
  {
   "text": "But thousands of voices whispered her name.",
   "tag": "[whispers]",
   "pause": 0.115
  },
  {
   "text": "Across the arena stood a girl in a white cloak.",
   "tag": "[mysterious]",
   "pause": 0.075
  },
  {
   "text": "The bell rang.",
   "tag": "[serious]",
   "pause": 0.115
  },
  {
   "text": "A bolt of lightning struck Quinn's feet.",
   "tag": "[excited]",
   "pause": 0.04
  },
  {
   "text": "She jumped backward and summoned a wall of fire.",
   "tag": "[excited]",
   "pause": 0.04
  },
  {
   "text": "The stranger walked straight through it.",
   "tag": "[serious]",
   "pause": 0.075
  },
  {
   "text": "Quinn launched three glowing energy blasts.",
   "tag": "[excited]",
   "pause": 0.04
  },
  {
   "text": "The stranger blocked them with one hand.",
   "tag": "[serious]",
   "pause": 0.055
  },
  {
   "text": "Then vanished.",
   "tag": "[softly]",
   "pause": 0.075
  },
  {
   "text": "A powerful kick sent Quinn crashing across the arena.",
   "tag": "[excited]",
   "pause": 0.075
  },
  {
   "text": "She struggled to stand.",
   "tag": "[serious]",
   "pause": 0.04
  },
  {
   "text": "Blood trickled from a small cut on her cheek.",
   "tag": "[serious]",
   "pause": 0.075
  },
  {
   "text": "The stranger raised both hands.",
   "tag": "[serious]",
   "pause": 0.04
  },
  {
   "text": "The entire arena lifted into the sky.",
   "tag": "[mysterious]",
   "pause": 0.115
  },
  {
   "text": "Quinn closed her eyes.",
   "tag": "[softly]",
   "pause": 0.055
  },
  {
   "text": "And unleashed every bit of magic she had left.",
   "tag": "[excited]",
   "pause": 0.055
  },
  {
   "text": "Fire. Lightning. And a massive violet shockwave.",
   "tag": "[excited]",
   "pause": 0.115,
   "speak": "Fire, lightning, and a massive violet shockwave."
  },
  {
   "text": "The stranger's cloak disintegrated into glowing particles.",
   "tag": "[mysterious]",
   "pause": 0.075
  },
  {
   "text": "But underneath was a little girl.",
   "tag": "[softly]",
   "pause": 0.055
  },
  {
   "text": "She looked terrified.",
   "tag": "[softly]",
   "pause": 0.055
  },
  {
   "text": "“Please don't win.”",
   "tag": "[whispers]",
   "pause": 0.115,
   "speak": "Please don't win.",
   "voice": "girl",
   "fx": "whisper"
  },
  {
   "text": "The empty seats filled with shadowy figures.",
   "tag": "[mysterious]",
   "pause": 0.055
  },
  {
   "text": "“THE NEXT CHAMPION HAS BEEN SELECTED.”",
   "tag": "[serious]",
   "pause": 0.115,
   "speak": "The next champion has been selected.",
   "voice": "announcer",
   "fx": "giant"
  },
  {
   "text": "Every shadow turned toward Quinn.",
   "tag": "[slowly]",
   "pause": 0.04
  }
 ],
