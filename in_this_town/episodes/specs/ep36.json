 "lines": [
  {
   "text": "“Congratulations, Grayson. You've been selected.”",
   "tag": "[cheerfully]",
   "pause": 0.12,
   "voice": "host",
   "fx": "tv",
   "speak": "Congratulations, Grayson! You've been selected."
  },
  {
   "text": "The television switched on by itself.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "A smiling host appeared.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "“Survive for five minutes, and you can go home.”",
   "tag": "[cheerfully]",
   "pause": 0.5,
   "voice": "host",
   "fx": "tv",
   "speak": "Survive for five minutes, and you can go home."
  },
  {
   "text": "Grayson's bedroom walls collapsed.",
   "tag": "[serious]",
   "pause": 0.25
  },
  {
   "text": "He was inside an enormous shopping mall.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "Thousands of empty seats surrounded him.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "A countdown appeared overhead.",
   "tag": "[mysterious]",
   "pause": 0.08
  },
  {
   "text": "FIVE MINUTES.",
   "tag": "[serious]",
   "pause": 0.12,
   "speak": "Five minutes."
  },
  {
   "text": "“Release the hunters.”",
   "tag": "[excited]",
   "pause": 0.15,
   "voice": "host",
   "fx": "pa",
   "speak": "Release the hunters!"
  },
  {
   "text": "Three masked figures emerged from the darkness.",
   "tag": "[serious]",
   "pause": 0.06
  },
  {
   "text": "Grayson ran.",
   "tag": "[urgent]",
   "pause": 0.1
  },
  {
   "text": "Gunshots shattered the glass behind him.",
   "tag": "[urgent]",
   "pause": 0.06
  },
  {
   "text": "He slid beneath a closing security gate.",
   "tag": "[urgent]",
   "pause": 0.06
  },
  {
   "text": "Grabbed a metal pipe.",
   "tag": "[urgent]",
   "pause": 0.06
  },
  {
   "text": "And struck the first hunter across the mask.",
   "tag": "[urgent]",
   "pause": 0.15
  },
  {
   "text": "It cracked.",
   "tag": "[serious]",
   "pause": 0.2
  },
  {
   "text": "Inside was a television screen.",
   "tag": "[quietly]",
   "pause": 0.06
  },
  {
   "text": "Showing Grayson's face.",
   "tag": "[quietly]",
   "pause": 0.1
  },
  {
   "text": "The second hunter tackled him.",
   "tag": "[urgent]",
   "pause": 0.06
  },
  {
   "text": "Grayson kicked it away and sprinted toward the exit.",
   "tag": "[urgent]",
   "pause": 0.06
  },
  {
   "text": "“TEN SECONDS. NINE. EIGHT.”",
   "tag": "[excited]",
   "pause": 0.1,
   "voice": "host",
   "fx": "pa",
   "speak": "Ten seconds! Nine! Eight!"
  },
  {
   "text": "He smashed through the final door.",
   "tag": "[urgent]",
   "pause": 0.1
  },
  {
   "text": "And collapsed onto his bedroom floor.",
   "tag": "[serious]",
   "pause": 0.25
  },
  {
   "text": "The television applauded.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "“Congratulations! You've won!”",
   "tag": "[excited]",
   "pause": 0.25,
   "voice": "host",
   "fx": "tv",
   "speak": "Congratulations! You've won!"
  },
  {
   "text": "Grayson looked outside.",
   "tag": "[quietly]",
   "pause": 0.06
  },
  {
   "text": "Every house on his street was empty.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "Every window contained a television.",
   "tag": "[mysterious]",
   "pause": 0.06
  },
  {
   "text": "And every television showed him.",
   "tag": "[serious]",
   "pause": 0.25
  },
  {
   "text": "The host smiled.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "“Now, let's see how long you survive as the hunter.”",
   "tag": "[cheerfully]",
   "pause": 0.1,
   "voice": "host",
   "fx": "tv",
   "speak": "Now, let's see how long you survive as the hunter."
  }
 ],
