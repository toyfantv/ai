 "lines": [
  {
   "text": "Every night at 3:17, the abandoned hospital's lights turn on.",
   "tag": "[calm]",
   "pause": 0.25,
   "speak": "Every night at three seventeen, the abandoned hospital's lights turn on."
  },
  {
   "text": "But the hospital was demolished twelve years ago.",
   "tag": "[mysterious]",
   "pause": 0.29
  },
  {
   "text": "Grayson found it standing at the end of an empty road.",
   "tag": "[calm]",
   "pause": 0.22
  },
  {
   "text": "Inside, the hallways smelled like fresh paint.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "The lights hummed.",
   "tag": "[softly]",
   "pause": 0.25
  },
  {
   "text": "Every patient room was perfectly clean.",
   "tag": "[mysterious]",
   "pause": 0.25
  },
  {
   "text": "\"Patient Grayson, please return to your room.\"",
   "tag": "[calm]",
   "pause": 0.29,
   "speak": "Patient Grayson, please return to your room.",
   "voice": "pa",
   "fx": "pa"
  },
  {
   "text": "He froze.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "He'd never been there before.",
   "tag": "[mysterious]",
   "pause": 0.29
  },
  {
   "text": "A nurse appeared at the end of the corridor.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "Her face hid behind a cracked porcelain mask.",
   "tag": "[mysterious]",
   "pause": 0.22
  },
  {
   "text": "She pointed toward Room 217.",
   "tag": "[calm]",
   "pause": 0.32,
   "speak": "She pointed toward Room two seventeen."
  },
  {
   "text": "Grayson slowly opened the door.",
   "tag": "[softly]",
   "pause": 0.25
  },
  {
   "text": "Inside was a hospital bed.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "A television.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "And a photograph of himself sleeping.",
   "tag": "[mysterious]",
   "pause": 0.36
  },
  {
   "text": "The television switched on.",
   "tag": "[calm]",
   "pause": 0.18
  },
  {
   "text": "It showed Grayson standing in the same room.",
   "tag": "[mysterious]",
   "pause": 0.22
  },
  {
   "text": "But the recording was dated tomorrow.",
   "tag": "[mysterious]",
   "pause": 0.36
  },
  {
   "text": "On screen, he turned toward the camera.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "And whispered,",
   "tag": "[softly]",
   "pause": 0.15
  },
  {
   "text": "\"Don't let them discharge you.\"",
   "tag": "[whispers]",
   "pause": 0.36,
   "speak": "Don't let them discharge you.",
   "voice": "tvboy",
   "fx": "tv"
  },
  {
   "text": "Behind him, the nurse appeared.",
   "tag": "[softly]",
   "pause": 0.55
  },
  {
   "text": "The lights went out.",
   "tag": "[calm]",
   "pause": 0.5
  },
  {
   "text": "When they returned, the hallway was gone.",
   "tag": "[mysterious]",
   "pause": 0.22
  },
  {
   "text": "Only an endless row of hospital beds remained.",
   "tag": "[mysterious]",
   "pause": 0.22
  },
  {
   "text": "And every bed was occupied.",
   "tag": "[softly]",
   "pause": 0.36
  },
  {
   "text": "Except his.",
   "tag": "[whispers]",
   "pause": 0.15
  }
 ],
