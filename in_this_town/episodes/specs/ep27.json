 "lines": [
  {
   "text": "Every night at 3:17, the abandoned hospital's lights turn on.",
   "tag": "[calm]",
   "pause": 0.18,
   "speak": "Every night at three seventeen, the abandoned hospital's lights turn on."
  },
  {
   "text": "But it was demolished twelve years ago.",
   "tag": "[mysterious]",
   "pause": 0.21
  },
  {
   "text": "Grayson found it at the end of an empty road.",
   "tag": "[calm]",
   "pause": 0.16
  },
  {
   "text": "A guard locked the doors behind him.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "The receptionist didn't look up.",
   "tag": "[calm]",
   "pause": 0.11
  },
  {
   "text": "\"Welcome back, Grayson.\"",
   "tag": "[calm]",
   "pause": 0.18,
   "speak": "Welcome back, Grayson.",
   "voice": "recep"
  },
  {
   "text": "He'd never been there before.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "A janitor mopped an already spotless floor.",
   "tag": "[calm]",
   "pause": 0.16
  },
  {
   "text": "In the waiting room, no one blinked.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "\"Patient Grayson, please return to your room.\"",
   "tag": "[calm]",
   "pause": 0.21,
   "speak": "Patient Grayson, please return to your room.",
   "voice": "pa",
   "fx": "pa"
  },
  {
   "text": "A little boy tugged his sleeve.",
   "tag": "[softly]",
   "pause": 0.11
  },
  {
   "text": "\"She's coming.\"",
   "tag": "[whispers]",
   "pause": 0.21,
   "speak": "She's coming.",
   "voice": "kid"
  },
  {
   "text": "A nurse in a cracked porcelain mask waited down the hall.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "She pointed toward Room 217.",
   "tag": "[calm]",
   "pause": 0.21,
   "speak": "She pointed toward Room two seventeen."
  },
  {
   "text": "Grayson slowly opened the door.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "Inside was a bed, a TV, and a photo of him asleep.",
   "tag": "[mysterious]",
   "pause": 0.23
  },
  {
   "text": "The television switched on.",
   "tag": "[calm]",
   "pause": 0.13
  },
  {
   "text": "It showed him, in this room.",
   "tag": "[mysterious]",
   "pause": 0.14
  },
  {
   "text": "But the recording was dated tomorrow.",
   "tag": "[mysterious]",
   "pause": 0.23
  },
  {
   "text": "On screen, he whispered,",
   "tag": "[softly]",
   "pause": 0.11
  },
  {
   "text": "\"Don't let them discharge you.\"",
   "tag": "[whispers]",
   "pause": 0.26,
   "speak": "Don't let them discharge you.",
   "voice": "tvboy",
   "fx": "tv"
  },
  {
   "text": "Behind him, the nurse appeared.",
   "tag": "[softly]",
   "pause": 0.4
  },
  {
   "text": "The lights went out.",
   "tag": "[calm]",
   "pause": 0.36
  },
  {
   "text": "When they returned, the hallway was gone.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "Only endless rows of beds remained.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "A doctor was checking every chart.",
   "tag": "[calm]",
   "pause": 0.16
  },
  {
   "text": "Every bed was occupied.",
   "tag": "[softly]",
   "pause": 0.23
  },
  {
   "text": "Except his.",
   "tag": "[whispers]",
   "pause": 0.11
  }
 ],
