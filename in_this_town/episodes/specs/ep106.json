 "lines": [
  {
   "text": "In Plumbwick, every lie makes you lighter.",
   "speak": "In Plumwick, every lie makes you lighter.",
   "tag": "[warm]",
   "pause": 0.14
  },
  {
   "text": "Praise your aunt's awful soup, and your heels lift.",
   "tag": "[playful]",
   "pause": 0.1
  },
  {
   "text": "Fake a cough, and you clear the fence.",
   "tag": "[playful]",
   "pause": 0.12
  },
  {
   "text": "Kids get iron boots at seven. The courthouse ceiling has a net.",
   "tag": "[amused]",
   "pause": 0.14
  },
  {
   "text": "Hattie Moss had never told a lie. She wore paper slippers.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Her brother Pip lied before breakfast.",
   "tag": "[playful]",
   "pause": 0.08
  },
  {
   "text": "“I brushed my teeth!”",
   "speak": "I brushed my teeth!",
   "voice": "pip",
   "tag": "[cheerfully]",
   "pause": 0.08
  },
  {
   "text": "He needed a diver's belt just to reach the cereal.",
   "tag": "[amused]",
   "pause": 0.16
  },
  {
   "text": "On Founders' Day, the Governor unveiled a glass peacock.",
   "tag": "[excited]",
   "pause": 0.12
  },
  {
   "text": "Then, one baseball.",
   "tag": "[flatly]",
   "pause": 0.5
  },
  {
   "text": "“I'll ask every one of you!”",
   "speak": "I'll ask every one of you!",
   "voice": "governor",
   "tag": "[furious]",
   "pause": 0.08
  },
  {
   "text": "The glove was still on Pip's hand.",
   "tag": "[tense]",
   "pause": 0.1
  },
  {
   "text": "One more lie, and no belt could hold him.",
   "tag": "[tense]",
   "pause": 0.12
  },
  {
   "text": "“Boy. Did you throw it?”",
   "speak": "Boy. Did you throw it?",
   "voice": "governor",
   "tag": "[coldly]",
   "pause": 0.14
  },
  {
   "text": "“I threw it! I hate your ugly bird!”",
   "speak": "I threw it! I hate your ugly bird!",
   "voice": "hattie",
   "tag": "[shouting]",
   "pause": 0.16
  },
  {
   "text": "Her first lie ever.",
   "tag": "[softly]",
   "pause": 0.12
  },
  {
   "text": "The floor let go.",
   "tag": "[hushed]",
   "pause": 0.05
  },
  {
   "text": "She went up like a popped cork and rang off the glass.",
   "tag": "[excited]",
   "pause": 0.2
  },
  {
   "text": "It took the fire brigade four hours.",
   "tag": "[amused]",
   "pause": 0.16
  },
  {
   "text": "Now she needs iron boots to cross the street.",
   "tag": "[warm]",
   "pause": 0.14
  },
  {
   "text": "But at sunset, she unbuckles them and swears she did the dishes.",
   "tag": "[warm]",
   "pause": 0.14
  },
  {
   "text": "Pip, who hasn't lied since, holds the rope.",
   "tag": "[tender]",
   "pause": 0
  }
 ],
