 "lines": [
  {
   "text": "At exactly 2 AM, every soldier at the abandoned training facility woke up.",
   "tag": "[mysterious]",
   "pause": 0.055,
   "speak": "At exactly two A.M., every soldier at the abandoned training facility woke up."
  },
  {
   "text": "The strange thing was, none of them were alive.",
   "tag": "[serious]",
   "pause": 0.095
  },
  {
   "text": "Eli discovered the facility while exploring an empty industrial district.",
   "tag": "[mysterious]",
   "pause": 0.055
  },
  {
   "text": "Inside, hundreds of targets stood perfectly still.",
   "tag": "[mysterious]",
   "pause": 0.075
  },
  {
   "text": "Then the lights turned red.",
   "tag": "[serious]",
   "pause": 0.15
  },
  {
   "text": "“TRAINING SESSION RESUMED.”",
   "tag": "[calm]",
   "pause": 0.095,
   "speak": "Training session resumed.",
   "voice": "pa",
   "fx": "pa"
  },
  {
   "text": "Every target turned toward him.",
   "tag": "[serious]",
   "pause": 0.075
  },
  {
   "text": "Gunfire erupted.",
   "tag": "[excited]",
   "pause": 0.3
  },
  {
   "text": "Eli dove behind a concrete barrier.",
   "tag": "[excited]",
   "pause": 0.04
  },
  {
   "text": "Bullets struck the wall, sending sparks and dust into the air.",
   "tag": "[excited]",
   "pause": 0.055
  },
  {
   "text": "He grabbed a training rifle.",
   "tag": "[serious]",
   "pause": 0.04
  },
  {
   "text": "And fired back.",
   "tag": "[excited]",
   "pause": 0.15
  },
  {
   "text": "One soldier fell.",
   "tag": "[serious]",
   "pause": 0.04
  },
  {
   "text": "Then another.",
   "tag": "[serious]",
   "pause": 0.055
  },
  {
   "text": "But every time one collapsed, a new soldier appeared.",
   "tag": "[mysterious]",
   "pause": 0.075
  },
  {
   "text": "Eli sprinted through the facility.",
   "tag": "[excited]",
   "pause": 0.04
  },
  {
   "text": "He kicked open a steel door.",
   "tag": "[excited]",
   "pause": 0.04
  },
  {
   "text": "And found the control room.",
   "tag": "[mysterious]",
   "pause": 0.075
  },
  {
   "text": "Inside was a giant screen.",
   "tag": "[mysterious]",
   "pause": 0.04
  },
  {
   "text": "It showed hundreds of identical training sessions.",
   "tag": "[mysterious]",
   "pause": 0.04
  },
  {
   "text": "All featuring Eli.",
   "tag": "[serious]",
   "pause": 0.095
  },
  {
   "text": "Then a message appeared.",
   "tag": "[mysterious]",
   "pause": 0.055
  },
  {
   "text": "“FINAL TEST: ELIMINATE THE ORIGINAL.”",
   "tag": "[calm]",
   "pause": 0.095,
   "speak": "Final test. Eliminate the original.",
   "voice": "pa",
   "fx": "pa"
  },
  {
   "text": "The soldiers stopped firing.",
   "tag": "[serious]",
   "pause": 0.04
  },
  {
   "text": "Every mask turned toward the screen.",
   "tag": "[mysterious]",
   "pause": 0.075
  },
  {
   "text": "Eli looked closer.",
   "tag": "[softly]",
   "pause": 0.055
  },
  {
   "text": "The original wasn't him.",
   "tag": "[serious]",
   "pause": 0.055
  },
  {
   "text": "It was the person watching the footage.",
   "tag": "[whispers]",
   "pause": 0.095
  },
  {
   "text": "Then the control room camera slowly turned toward the viewer.",
   "tag": "[slowly]",
   "pause": 0.04
  }
 ],
