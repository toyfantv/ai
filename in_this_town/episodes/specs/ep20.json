 "lines": [
  {
   "text": "Kai had spent weeks searching the islands for a legendary fruit.",
   "tag": "[conversational]",
   "pause": 0.3
  },
  {
   "text": "Then one morning, he found something nobody had ever seen.",
   "tag": "[curious]",
   "pause": 0.4
  },
  {
   "text": "A completely transparent fruit.",
   "tag": "[in awe]",
   "pause": 0.5
  },
  {
   "text": "It had no color.",
   "tag": "[mysterious]",
   "pause": 0.3
  },
  {
   "text": "No name.",
   "tag": "[mysterious]",
   "pause": 0.3
  },
  {
   "text": "And no description.",
   "tag": "[mysterious]",
   "pause": 0.5
  },
  {
   "text": "When Kai tried to inspect it, his screen displayed one word.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "\"UNKNOWN.\"",
   "speak": "Unknown.",
   "voice": "system",
   "fx": "giant",
   "tag": "[slowly, deep]",
   "pause": 0.45
  },
  {
   "text": "He took a bite.",
   "tag": "[conversational]",
   "pause": 0.6
  },
  {
   "text": "Nothing happened.",
   "tag": "[flat]",
   "pause": 0.4
  },
  {
   "text": "Disappointed, Kai threw the fruit into the ocean.",
   "tag": "[conversational]",
   "pause": 0.45
  },
  {
   "text": "But the next time he opened his inventory, every item was gone.",
   "tag": "[uneasy]",
   "pause": 0.3
  },
  {
   "text": "His sword.",
   "tag": "[tense]",
   "pause": 0.3
  },
  {
   "text": "His money.",
   "tag": "[tense]",
   "pause": 0.3
  },
  {
   "text": "Even his level.",
   "tag": "[tense]",
   "pause": 0.35
  },
  {
   "text": "Everything had reset to zero.",
   "tag": "[ominous]",
   "pause": 0.45
  },
  {
   "text": "Then a strange notification appeared.",
   "tag": "[mysterious]",
   "pause": 0.35
  },
  {
   "text": "\"YOU HAVE UNLOCKED THE FIRST VERSION.\"",
   "speak": "You have unlocked the first version.",
   "voice": "system",
   "fx": "giant",
   "tag": "[slowly, deep]",
   "pause": 0.5
  },
  {
   "text": "Suddenly, the ocean drained away.",
   "tag": "[urgent]",
   "pause": 0.45,
   "audio": "build/ep20/local_lines/line_18.wav"
  },
  {
   "text": "The islands began rearranging themselves.",
   "tag": "[urgent]",
   "pause": 0.4,
   "audio": "build/ep20/local_lines/line_19.wav"
  },
  {
   "text": "And thousands of ancient buildings rose from the seabed.",
   "tag": "[in awe]",
   "pause": 0.45,
   "audio": "build/ep20/local_lines/line_20.wav"
  },
  {
   "text": "Kai realized he hadn't gained a new power.",
   "tag": "[mysterious]",
   "pause": 0.35,
   "audio": "build/ep20/local_lines/line_21.wav"
  },
  {
   "text": "He'd unlocked a version of the world that existed before anyone else joined.",
   "tag": "[in awe]",
   "pause": 0.45,
   "audio": "build/ep20/local_lines/line_22.wav"
  },
  {
   "text": "Then a message appeared.",
   "tag": "[mysterious]",
   "pause": 0.35,
   "audio": "build/ep20/local_lines/line_23.wav"
  },
  {
   "text": "\"WELCOME BACK, CREATOR.\"",
   "speak": "Welcome back, Creator.",
   "voice": "system",
   "fx": "chorus",
   "tag": "[slowly, deep]",
   "pause": 0.5,
   "audio": "build/ep20/local_lines/line_24.wav"
  },
  {
   "text": "And every NPC bowed.",
   "speak": "And every N P C bowed.",
   "tag": "[in awe]",
   "pause": 0.3,
   "audio": "build/ep20/local_lines/line_25.wav"
  }
 ],
