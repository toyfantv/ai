 "lines": [
  {"text": "In this town, the sun never sets.", "tag": "[mysterious]"},
  {"text": "It's always exactly noon.", "tag": "[intrigued]"},
  {"text": "The sky is always blue.", "tag": "[calm]"},
  {"text": "And nobody has ever seen nighttime.", "tag": "[mysterious]", "pause": 0.5},
  {"text": "But one day, a boy named Lucas noticed something strange.", "tag": "[curious]", "pause": 0.4},
