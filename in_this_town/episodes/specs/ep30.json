 "lines": [
  {
   "text": "Piper had never seen anyone enter the old amusement park.",
   "tag": "[calm]",
   "pause": 0.14
  },
  {
   "text": "But every night, the rides started moving.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "The Ferris wheel turned.",
   "tag": "[calm]",
   "pause": 0.1
  },
  {
   "text": "The carousel played music.",
   "tag": "[calm]",
   "pause": 0.1
  },
  {
   "text": "And the ticket booth lights switched on.",
   "tag": "[mysterious]",
   "pause": 0.15
  },
  {
   "text": "“My grandpa says it never opened.”",
   "speak": "My grandpa says it never opened.",
   "voice": "theo",
   "tag": "[quietly]",
   "pause": 0.15
  },
  {
   "text": "One evening, the gates stood wide open.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "An old man handed her a ticket.",
   "tag": "[calm]",
   "pause": 0.12
  },
  {
   "text": "“You're late.”",
   "speak": "You're late.",
   "voice": "ticket",
   "tag": "[flatly]",
   "pause": 0.15
  },
  {
   "text": "No guests. But every ride was running.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "“Sold my last one.”",
   "speak": "Sold my last one.",
   "voice": "seller",
   "tag": "[flatly]",
   "pause": 0.15
  },
  {
   "text": "Then Piper saw a blue creature, alone on the carousel.",
   "tag": "[mysterious]",
   "pause": 0.1
  },
  {
   "text": "It was holding a red balloon.",
   "tag": "[softly]",
   "pause": 0.16
  },
  {
   "text": "It slowly turned, and pointed at the Ferris wheel.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "“It's full.”",
   "speak": "It's full.",
   "voice": "boy",
   "tag": "[softly]",
   "pause": 0.16
  },
  {
   "text": "Every seat was occupied.",
   "tag": "[calm]",
   "pause": 0.1
  },
  {
   "text": "But nobody was visible.",
   "tag": "[softly]",
   "pause": 0.17
  },
  {
   "text": "The carousel music stopped.",
   "tag": "[calm]",
   "pause": 0.19
  },
  {
   "text": "“One guest remains.”",
   "speak": "One guest remains.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.17,
   "fx": "pa"
  },
  {
   "text": "The workers set down their tools.",
   "tag": "[calm]",
   "pause": 0.14
  },
  {
   "text": "The creature handed Piper the balloon.",
   "tag": "[softly]",
   "pause": 0.14
  },
  {
   "text": "It walked through the exit gate, and the gate locked behind it.",
   "tag": "[mysterious]",
   "pause": 0.15,
   "speak": "It walked through the exit gate... and the gate locked behind it."
  },
  {
   "text": "Written on the balloon was her name.",
   "tag": "[softly]",
   "pause": 0.17,
   "speak": "Written on the balloon... was her name."
  },
  {
   "text": "“Thank you for taking the final shift.”",
   "speak": "Thank you for taking the final shift.",
   "voice": "pa",
   "tag": "[calm]",
   "pause": 0.19,
   "fx": "pa"
  },
  {
   "text": "Every ride stopped.",
   "tag": "[calm]",
   "pause": 0.17
  },
  {
   "text": "Then hundreds of invisible footsteps began approaching.",
   "tag": "[mysterious]",
   "pause": 0.16
  },
  {
   "text": "And the ticket booth switched from CLOSED to OPEN.",
   "tag": "[softly]",
   "pause": 0.14
  }
 ],
