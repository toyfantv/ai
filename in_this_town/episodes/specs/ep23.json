 "lines": [
  {
   "text": "Lily adopted a tiny golden dragon from the pet shop.",
   "tag": "[warm]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_00.wav"
  },
  {
   "text": "But something about it was strange.",
   "tag": "[mysterious]",
   "pause": 0.45,
   "audio": "build/ep23/local_lines/line_01.wav"
  },
  {
   "text": "It refused to enter her house.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_02.wav",
   "local": {
    "src": "en_us_007"
   }
  },
  {
   "text": "Every evening, it flew to the same empty plot across town.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_03.wav",
   "local": {
    "src": "en_us_007"
   },
   "speak": "Every evening, it flew to the same, empty plot across town."
  },
  {
   "text": "And sat there until midnight.",
   "tag": "[mysterious]",
   "pause": 0.55,
   "audio": "build/ep23/local_lines/line_04.wav"
  },
  {
   "text": "One day, Lily followed it.",
   "tag": "[conversational]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_05.wav"
  },
  {
   "text": "The dragon landed beside an old mailbox.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_06.wav"
  },
  {
   "text": "There was no house.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_07.wav",
   "local": {
    "src": "en_us_007"
   }
  },
  {
   "text": "Just grass.",
   "tag": "[mysterious]",
   "pause": 0.55,
   "audio": "build/ep23/local_lines/line_08.wav"
  },
  {
   "text": "Then the dragon dropped a small golden key.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_09.wav"
  },
  {
   "text": "Lily picked it up.",
   "tag": "[conversational]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_10.wav"
  },
  {
   "text": "A glowing outline appeared around the empty plot.",
   "tag": "[in awe]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_11.wav",
   "local": {
    "src": "en_us_010"
   },
   "speak": "A glowing outline appeared, around the empty plot."
  },
  {
   "text": "Slowly, an entire house became visible.",
   "tag": "[in awe]",
   "pause": 0.55,
   "audio": "build/ep23/local_lines/line_12.wav"
  },
  {
   "text": "Inside were toys, furniture, and photographs.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_13.wav",
   "local": {
    "src": "en_us_007"
   },
   "speak": "Inside, were toys, furniture, and photographs."
  },
  {
   "text": "Every picture showed the same little girl.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_14.wav"
  },
  {
   "text": "But her face had been erased.",
   "tag": "[whispers]",
   "pause": 0.55,
   "audio": "build/ep23/local_lines/line_15.wav",
   "local": {
    "src": "en_us_010"
   }
  },
  {
   "text": "Suddenly, Lily received a notification.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_16.wav"
  },
  {
   "text": "\"FRIEND REQUEST FROM UNKNOWN PLAYER.\"",
   "tag": "[slowly]",
   "pause": 0.45,
   "speak": "Friend request from unknown player.",
   "voice": "system",
   "fx": "giant",
   "audio": "build/ep23/local_lines/line_17.wav"
  },
  {
   "text": "She accepted.",
   "tag": "[conversational]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_18.wav"
  },
  {
   "text": "The erased face appeared in every photograph.",
   "tag": "[in awe]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_19.wav"
  },
  {
   "text": "And the dragon began jumping with excitement.",
   "tag": "[excited]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_20.wav"
  },
  {
   "text": "Then a message arrived.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_21.wav"
  },
  {
   "text": "\"THANK YOU FOR REMEMBERING ME.\"",
   "tag": "[softly]",
   "pause": 0.55,
   "speak": "Thank you for remembering me.",
   "voice": "girl",
   "audio": "build/ep23/local_lines/line_22.wav"
  },
  {
   "text": "For one second, a little girl appeared in the doorway.",
   "tag": "[softly]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_23.wav"
  },
  {
   "text": "She waved.",
   "tag": "[softly]",
   "pause": 0.45,
   "audio": "build/ep23/local_lines/line_24.wav"
  },
  {
   "text": "And the house faded away.",
   "tag": "[softly]",
   "pause": 0.3,
   "audio": "build/ep23/local_lines/line_25.wav",
   "local": {
    "src": "en_us_007"
   },
   "speak": "And the house... faded away."
  }
 ],
