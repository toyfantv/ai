 "lines": [
  {
   "text": "Jake had lived in the same Brookhaven house for three months.",
   "tag": "[conversational]",
   "pause": 0.3
  },
  {
   "text": "But every morning, something was different.",
   "tag": "[curious]",
   "pause": 0.35
  },
  {
   "text": "A chair had moved.",
   "tag": "[uneasy]",
   "pause": 0.5
  },
  {
   "text": "A window was open.",
   "tag": "[uneasy]",
   "pause": 0.5
  },
  {
   "text": "And food kept disappearing from his kitchen.",
   "tag": "[uneasy]",
   "pause": 0.45
  },
  {
   "text": "So one night, Jake placed a camera in the hallway.",
   "tag": "[conversational]",
   "pause": 0.6
  },
  {
   "text": "At 3:17 AM, the camera detected movement.",
   "speak": "At three seventeen A M, the camera detected movement.",
   "tag": "[mysterious]",
   "pause": 0.45
  },
  {
   "text": "Jake watched the recording.",
   "tag": "[tense]",
   "pause": 0.5
  },
  {
   "text": "His bedroom wall slowly opened.",
   "tag": "[ominous]",
   "pause": 0.9
  },
  {
   "text": "A Roblox avatar stepped out.",
   "tag": "[whispers]",
   "pause": 0.5
  },
  {
   "text": "It looked like an ordinary player.",
   "tag": "[uneasy]",
   "pause": 0.3
  },
  {
   "text": "Except it had no username.",
   "tag": "[ominous]",
   "pause": 0.6
  },
  {
   "text": "The stranger walked into Jake's kitchen.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "Opened the refrigerator.",
   "tag": "[tense]",
   "pause": 0.5
  },
  {
   "text": "And calmly sat at the table.",
   "tag": "[uneasy]",
   "pause": 0.6
  },
  {
   "text": "Then it looked directly into the camera.",
   "tag": "[ominous]",
   "pause": 0.75
  },
  {
   "text": "A message appeared on Jake's screen.",
   "tag": "[tense]",
   "pause": 0.3
  },
  {
   "text": "\"STOP RECORDING MY HOUSE.\"",
   "speak": "Stop recording my house.",
   "voice": "homeowner",
   "fx": "radio",
   "tag": "[menacing, slowly]",
   "pause": 0.65
  },
  {
   "text": "Jake checked the server player list.",
   "tag": "[tense]",
   "pause": 0.35
  },
  {
   "text": "There were only two players online.",
   "tag": "[uneasy]",
   "pause": 0.45
  },
  {
   "text": "Himself.",
   "tag": "[tense]",
   "pause": 0.5
  },
  {
   "text": "And someone named HOMEOWNER.",
   "speak": "And someone named Homeowner.",
   "tag": "[ominous]",
   "pause": 0.75
  },
  {
   "text": "Suddenly, the walls around Jake began moving.",
   "tag": "[urgent]",
   "pause": 0.6
  },
  {
   "text": "And the front door disappeared.",
   "tag": "[ominous]",
   "pause": 0.3
  }
 ],
