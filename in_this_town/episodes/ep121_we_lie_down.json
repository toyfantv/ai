 "lines": [
  {
   "text": "When the shadow comes, we lie down.",
   "tag": "[matter-of-fact]",
   "pause": 0.24
  },
  {
   "text": "Anyone still standing goes up with it.",
   "tag": "[matter-of-fact]",
   "pause": 0.24
  },
  {
   "text": "We get married flat. Haircuts come out crooked.",
   "tag": "[deadpan]",
   "pause": 0.4
  },
  {
   "text": "Today it stopped over our house.",
   "tag": "[quietly]",
   "pause": 0.45
  },
  {
   "text": "Nobody knows what it wants.",
   "tag": "[quietly]",
   "pause": 0.55
  },
  {
   "text": "Most days it crosses once, at noon. Ten breaths, then gone.",
   "tag": "[matter-of-fact]",
   "pause": 0.24,
   "speak": "Most days it crosses once, at noon. Ten breaths... then gone."
  },
  {
   "text": "We call it going up for the view.",
   "tag": "[deadpan]",
   "pause": 0.24
  },
  {
   "text": "Babies learn to drop before they learn to walk.",
   "tag": "[matter-of-fact]",
   "pause": 0.24
  },
  {
   "text": "Nobody here owns a kite.",
   "tag": "[deadpan]",
   "pause": 0.24
  },
  {
   "text": "Every summer is hotter. Mom says that's just summer.",
   "tag": "[flat]",
   "pause": 0.4
  },
  {
   "text": "My brother Pip is five. When it comes, I count for him.",
   "tag": "[warm]",
   "pause": 0.24
  },
  {
   "text": "One, two, flat.",
   "tag": "[softly]",
   "pause": 0.45,
   "speak": "One... two... flat."
  },
  {
   "text": "Ten breaths. Twenty. A hundred. Still here.",
   "tag": "[quietly]",
   "pause": 0.4,
   "speak": "Ten breaths. Twenty. A hundred... Still here."
  },
  {
   "text": "The whole town fits inside its shade.",
   "tag": "[quietly]",
   "pause": 0.24
  },
  {
   "text": "Mom says if you look up, you go up.",
   "tag": "[whispers]",
   "pause": 0.24
  },
  {
   "text": "By one o'clock, the whole town is lying in the road.",
   "tag": "[matter-of-fact]",
   "pause": 0.24,
   "speak": "By one o'clock, the whole town is lying in the road."
  },
  {
   "text": "“Faces down. Nobody moves.”",
   "tag": "[low, firm]",
   "pause": 0.24,
   "voice": "mom",
   "speak": "Faces down. Nobody moves."
  },
  {
   "text": "Old Mr. Abara has been lying in his garden since Tuesday.",
   "tag": "[deadpan]",
   "pause": 0.24,
   "speak": "Old Mister Abara has been lying in his garden since Tuesday."
  },
  {
   "text": "Past the edge of the shadow, the grass starts to smoke.",
   "tag": "[quietly]",
   "pause": 0.24
  },
  {
   "text": "“Don't look, child. Count your breaths.”",
   "tag": "[calm]",
   "pause": 0.24,
   "voice": "mrslee",
   "speak": "Don't look, child. Count your breaths."
  },
  {
   "text": "Last spring, Mr. Lee stood up to catch his hat.",
   "tag": "[quietly]",
   "pause": 0.24,
   "speak": "Last spring, Mister Lee stood up to catch his hat."
  },
  {
   "text": "She says he screamed all the way up.",
   "tag": "[quietly]",
   "pause": 0.24
  },
  {
   "text": "I was there. He was waving.",
   "tag": "[quietly]",
   "pause": 0.45
  },
  {
   "text": "Something drops into the road beside me.",
   "tag": "[tense]",
   "pause": 0.24
  },
  {
   "text": "A feather. Longer than our front door.",
   "tag": "[awed]",
   "pause": 0.24,
   "speak": "A feather... Longer than our front door."
  },
  {
   "text": "Its tips are burnt black.",
   "tag": "[quietly]",
   "pause": 0.4
  },
  {
   "text": "Then the shadow starts to grow. It's coming down.",
   "tag": "[tense]",
   "pause": 0.24
  },
  {
   "text": "“Flatter, Pip! Flatter!”",
   "tag": "[scared]",
   "pause": 0.24,
   "voice": "mom",
   "speak": "Flatter, Pip! Flatter!"
  },
  {
   "text": "“Is it hungry?”",
   "tag": "[whispers]",
   "pause": 0.24,
   "voice": "pip",
   "speak": "Is it... hungry?"
  },
  {
   "text": "I don't know.",
   "tag": "[whispers]",
   "pause": 0.24
  },
  {
   "text": "So I look up.",
   "tag": "[quietly]",
   "pause": 5.7
  },
  {
   "text": "It isn't hunting us.",
   "tag": "[in awe]",
   "pause": 0.24
  },
  {
   "text": "Behind it, the sun fills half the sky.",
   "tag": "[in awe]",
   "pause": 0.24
  },
  {
   "text": "Its feathers are burning. It doesn't move.",
   "tag": "[in awe]",
   "pause": 0.24
  },
  {
   "text": "Mr. Lee wasn't screaming.",
   "tag": "[realizing]",
   "pause": 0.24,
   "speak": "Mister Lee wasn't screaming."
  },
  {
   "text": "He was calling us.",
   "tag": "[realizing]",
   "pause": 0.24
  },
  {
   "text": "Its feet are open. Low enough to reach.",
   "tag": "[softly]",
   "pause": 0.3
  },
  {
   "text": "“Stay down!”",
   "tag": "[sharp]",
   "pause": 0.35,
   "voice": "mom",
   "speak": "Stay down!"
  },
  {
   "text": "When the shadow comes, we lie down.",
   "tag": "[quietly]",
   "pause": 0.24
  },
  {
   "text": "I stand up.",
   "tag": "[quietly]",
   "pause": 0.5
  },
  {
   "text": "One, two... up.",
   "tag": "[quietly]",
   "pause": 0.0,
   "speak": "One... two... up."
  }
 ],
