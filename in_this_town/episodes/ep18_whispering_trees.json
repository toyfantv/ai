 "lines": [
  {
   "text": "At exactly 6 PM, every tree in town started whispering people's names.",
   "speak": "At exactly six PM, every tree in town started whispering people's names.",
   "tag": "[mysterious]",
   "pause": 0.2
  },
  {
   "text": "At first, everyone thought it was a prank.",
   "tag": "[conversational]",
   "pause": 0.2
  },
  {
   "text": "Until the people whose names were called began disappearing.",
   "tag": "[ominous]",
   "pause": 0.15
  },
  {
   "text": "One by one.",
   "tag": "[whispers]",
   "pause": 0.3
  },
  {
   "text": "A boy named Daniel was walking home when the biggest oak tree in the park whispered his name.",
   "tag": "[curious]",
   "pause": 0.12
  },
  {
   "text": "\"Daniel.\"",
   "voice": "trees",
   "fx": "whisper",
   "tag": "[whispers, eerie]",
   "pause": 0.19
  },
  {
   "text": "He froze.",
   "tag": "[tense]",
   "pause": 0.22
  },
  {
   "text": "Then the tree whispered something else.",
   "tag": "[uneasy]",
   "pause": 0.12
  },
  {
   "text": "\"You have six minutes.\"",
   "voice": "trees",
   "fx": "whisper",
   "tag": "[whispers, eerie]",
   "pause": 0.19
  },
  {
   "text": "Daniel ran.",
   "tag": "[urgent]",
   "pause": 0.12
  },
  {
   "text": "As he passed the park, he noticed names carved into every tree.",
   "tag": "[tense]",
   "pause": 0.2
  },
  {
   "text": "Some were crossed out.",
   "tag": "[uneasy]",
   "pause": 0.12
  },
  {
   "text": "Others were glowing.",
   "tag": "[in awe]",
   "pause": 0.19
  },
  {
   "text": "Then he found his own name.",
   "tag": "[tense]",
   "pause": 0.19
  },
  {
   "text": "Beside it was a countdown.",
   "tag": "[uneasy]",
   "pause": 0.12
  },
  {
   "text": "00:59.",
   "speak": "Zero zero, fifty-nine.",
   "tag": "[tense]",
   "pause": 0.19
  },
  {
   "text": "Daniel desperately scratched his name off the bark.",
   "tag": "[urgent]",
   "pause": 0.19
  },
  {
   "text": "The countdown stopped.",
   "tag": "[relieved]",
   "pause": 0.25
  },
  {
   "text": "For a moment, everything went silent.",
   "tag": "[whispers]",
   "pause": 0.45
  },
  {
   "text": "Then hundreds of trees began whispering at once.",
   "tag": "[ominous]",
   "pause": 0.15
  },
  {
   "text": "\"Wrong name.\"",
   "voice": "trees",
   "fx": "chorus",
   "tag": "[whispers, eerie]",
   "pause": 0.25
  },
  {
   "text": "Daniel looked down.",
   "tag": "[uneasy]",
   "pause": 0.19
  },
  {
   "text": "The name he'd erased wasn't his.",
   "tag": "[tense]",
   "pause": 0.19
  },
  {
   "text": "It was his little sister's.",
   "tag": "[fearful]",
   "pause": 0.3
  },
  {
   "text": "And across town, every tree began calling her name.",
   "tag": "[ominous]",
   "pause": 0
  }
 ],
