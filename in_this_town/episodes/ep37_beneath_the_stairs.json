 "lines": [
  {
   "text": "In the abandoned school, there was a staircase nobody used.",
   "tag": "[mysterious]",
   "pause": 0.15
  },
  {
   "text": "Not because it was broken.",
   "tag": "[mysterious]",
   "pause": 0.15
  },
  {
   "text": "Because every night, someone counted the steps.",
   "tag": "[mysterious]",
   "pause": 0.4
  },
  {
   "text": "One.",
   "speak": "One...",
   "tag": "[whispers]",
   "pause": 0.45,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "Two.",
   "speak": "Two...",
   "tag": "[whispers]",
   "pause": 0.45,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "Three.",
   "speak": "Three...",
   "tag": "[whispers]",
   "pause": 0.5,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "Quinn heard it while searching for her missing brother.",
   "tag": "[mysterious]",
   "pause": 0.12
  },
  {
   "text": "The voice was coming from underneath the stairs.",
   "tag": "[quietly]",
   "pause": 0.15
  },
  {
   "text": "She crouched down.",
   "tag": "[quietly]",
   "pause": 0.2
  },
  {
   "text": "A woman was sitting in the darkness.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "Her hair covered her face.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "Her knees were bent backward.",
   "tag": "[serious]",
   "pause": 0.25
  },
  {
   "text": "“Have you seen my son?”",
   "speak": "Have you seen my son?",
   "tag": "[whispers]",
   "pause": 0.4,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "Quinn shook her head.",
   "tag": "[quietly]",
   "pause": 0.15
  },
  {
   "text": "The woman slowly lifted her face.",
   "tag": "[quietly]",
   "pause": 0.95
  },
  {
   "text": "There were no eyes.",
   "tag": "[serious]",
   "pause": 0.2
  },
  {
   "text": "Only two deep, black holes.",
   "tag": "[serious]",
   "pause": 0.2
  },
  {
   "text": "Quinn screamed and ran.",
   "tag": "[urgent]",
   "pause": 0.12
  },
  {
   "text": "Behind her, the counting became faster.",
   "tag": "[urgent]",
   "pause": 0.14
  },
  {
   "text": "Four.",
   "speak": "Four!",
   "tag": "[whispers urgently]",
   "pause": 0.12,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "Five.",
   "speak": "Five.",
   "tag": "[whispers urgently]",
   "pause": 0.1,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "Six.",
   "speak": "Six!",
   "tag": "[whispers urgently]",
   "pause": 0.18,
   "fx": "whisper",
   "voice": "woman"
  },
  {
   "text": "She reached the exit.",
   "tag": "[urgent]",
   "pause": 0.1
  },
  {
   "text": "But the door opened onto the same staircase.",
   "tag": "[serious]",
   "pause": 0.2
  },
  {
   "text": "The woman was waiting at the bottom.",
   "tag": "[quietly]",
   "pause": 0.15
  },
  {
   "text": "This time, she was holding a child's backpack.",
   "tag": "[quietly]",
   "pause": 0.12
  },
  {
   "text": "Quinn recognized it.",
   "tag": "[quietly]",
   "pause": 0.14
  },
  {
   "text": "Her brother's.",
   "tag": "[quietly]",
   "pause": 0.25
  },
  {
   "text": "A small voice whispered from inside the backpack,",
   "tag": "[quietly]",
   "pause": 0.1
  },
  {
   "text": "“Quinn, don't look up.”",
   "speak": "Quinn. Don't look up.",
   "tag": "[whispers]",
   "pause": 0.4,
   "fx": "muffled",
   "voice": "brother"
  },
  {
   "text": "She froze.",
   "tag": "[quietly]",
   "pause": 0.65
  },
  {
   "text": "Something was crawling across the ceiling.",
   "tag": "[quietly]",
   "pause": 0.75
  },
  {
   "text": "And it was wearing her brother's face.",
   "tag": "[serious]",
   "pause": 0.1
  }
 ],
