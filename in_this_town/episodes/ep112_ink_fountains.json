 "lines": [
  {
   "text": "In Quillhaven, ink fountains burst from the ground, and anything near one wakes up.",
   "tag": "[mysterious]",
   "pause": 0.14
  },
  {
   "text": "Only a kid with a glowing gold heart can seal one. Every open fountain eats a star.",
   "tag": "[serious]",
   "pause": 0.14
  },
  {
   "text": "Arlo was that kid.",
   "tag": "[warm]",
   "pause": 0.1
  },
  {
   "text": "His partner Wren kicks anything that moves.",
   "tag": "[amused]",
   "pause": 0.1
  },
  {
   "text": "Checkers, a living picnic blanket, fears everything.",
   "tag": "[amused]",
   "pause": 0.14
  },
  {
   "text": "Every night, Arlo sealed one. But the stars kept vanishing, and every morning, his hands were inky.",
   "tag": "[serious]",
   "pause": 0.16
  },
  {
   "text": "Then a rumor: a black knight stood by every fountain right before it opened.",
   "tag": "[mysterious]",
   "pause": 0.12
  },
  {
   "text": "“Tonight, we catch him.”",
   "speak": "Tonight, we catch him.",
   "voice": "wren",
   "tag": "[determined]",
   "pause": 0.16
  },
  {
   "text": "At three a.m., the knight shuffled past, dripping ink.",
   "speak": "At three A M, the knight shuffled past, dripping ink.",
   "tag": "[whispers]",
   "pause": 0.1
  },
  {
   "text": "They followed him all the way into Arlo's room.",
   "tag": "[tense]",
   "pause": 0.12
  },
  {
   "text": "The floor cracked. Wren yanked off the helmet. Empty.",
   "tag": "[tense]",
   "pause": 0.14
  },
  {
   "text": "On the pillow sat a jar. Inside, flickering, was Arlo's heart.",
   "tag": "[softly]",
   "pause": 0.12
  },
  {
   "text": "His own ink had been sneaking out while he slept.",
   "tag": "[serious]",
   "pause": 0.16
  },
  {
   "text": "“Seal it, Arlo. Please.”",
   "speak": "Seal it, Arlo. Please.",
   "voice": "checkers",
   "tag": "[nervously]",
   "pause": 0.16
  },
  {
   "text": "His heart flew home. Wren and Checkers held on, and gold light filled the room.",
   "tag": "[warm]",
   "pause": 0.14
  },
  {
   "text": "Outside, every star blinked back on.",
   "tag": "[warm]",
   "pause": 0.2
  },
  {
   "text": "Next morning, one tiny drop of ink sat on his thumb.",
   "tag": "[mysterious]",
   "pause": 0.1
  }
 ],
 "samples": {
  "hiyah": {
   "text": "Hi-yah!",
   "voice": "wren",
   "tag": "[shouting]"
  },
