 "lines": [
  {
   "text": "In this town, you can buy extra time.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "There's a mysterious clock shop where one dollar buys one extra minute.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "People use it to finish homework, sleep longer, or escape being late.",
   "tag": "[warmly]",
   "pause": 0.4
  },
  {
   "text": "But there's one rule.",
   "tag": "[serious]",
   "pause": 0.32
  },
  {
   "text": "Never buy more than sixty minutes.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "One day, a boy named Max walked into the shop.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "He placed a hundred dollars on the counter.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "The shopkeeper looked terrified.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "But Max insisted.",
   "tag": "[determined]",
   "pause": 0.5
  },
  {
   "text": "Suddenly, every clock in town stopped.",
   "tag": "[dramatic]",
   "pause": 0.3
  },
  {
   "text": "Cars froze.",
   "tag": "[quietly]",
   "pause": 0.32
  },
  {
   "text": "Birds hung motionless in the air.",
   "tag": "[in awe]",
   "pause": 0.32
  },
  {
   "text": "And the sky turned completely white.",
   "tag": "[in awe]",
   "pause": 0.4
  },
  {
   "text": "Max smiled.",
   "tag": "[mischievous]",
   "pause": 0.32
  },
  {
   "text": "He had finally stopped time.",
   "tag": "[mischievous]",
   "pause": 0.5
  },
  {
   "text": "But then he noticed someone walking toward him.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "An old man carrying an enormous clock.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "The man looked exactly like Max.",
   "tag": "[shocked]",
   "pause": 0.4
  },
  {
   "text": "He pointed at the clock and whispered,",
   "tag": "[whispers]",
   "pause": 0.3
  },
  {
   "text": "“You didn't buy extra time.”",
   "speak": "You didn't buy extra time.",
   "voice": "oldmax",
   "tag": "[whispers, old]",
   "fx": "whisper",
   "pause": 0.3
  },
  {
   "text": "“You borrowed it from me.”",
   "speak": "You borrowed it from me.",
   "voice": "oldmax",
   "tag": "[whispers, ominous]",
   "fx": "whisper",
   "pause": 0.5
  },
  {
   "text": "Then the clock began counting backward.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "And Max started getting older.",
   "tag": "[whispers, terrified]",
   "pause": 0.0
  }
 ],
