 "lines": [
  {
   "text": "In Gullhaven, no name lasts longer than one year.",
   "tag": "[mysterious]",
   "pause": 0.12
  },
  {
   "text": "Every spring, everyone picks a new one, chalked on a slate.",
   "tag": "[playful]",
   "pause": 0.12
  },
  {
   "text": "This year the mayor is Pudding. Last year he was Captain Socks.",
   "tag": "[amused]",
   "pause": 0.12
  },
  {
   "text": "On the fountain, the founder's name is chiseled off.",
   "tag": "[curious]",
   "pause": 0.12
  },
  {
   "text": "And the morning after, a man in a tall hat knocks on every door.",
   "tag": "[ominous]",
   "pause": 0.12
  },
  {
   "text": "“Any Hargreaves here?”",
   "tag": "[smooth, polite]",
   "pause": 0.12,
   "voice": "collector",
   "speak": "Any Hargreaves here?"
  },
  {
   "text": "Every door shuts fast.",
   "tag": "[tense]",
   "pause": 0.12
  },
  {
   "text": "But Tilly loved her name. It was her great-great-grandma's.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "So this spring she kept it, and told Mom she was Brenda.",
   "tag": "[sneaky]",
   "pause": 0.12
  },
  {
   "text": "“Brenda? Really?”",
   "tag": "[amused, doubtful]",
   "pause": 0.12,
   "voice": "mom",
   "speak": "Brenda? Really?"
  },
  {
   "text": "Next morning, the tall hat was on her doorstep.",
   "tag": "[ominous]",
   "pause": 0.12
  },
  {
   "text": "“Matilda Hargreave?”",
   "tag": "[reading slowly, pleased]",
   "pause": 0.12,
   "voice": "collector",
   "speak": "Matilda Hargreave?"
  },
  {
   "text": "“That's me!”",
   "tag": "[proud, cheerful]",
   "pause": 0.12,
   "voice": "tilly",
   "speak": "That's me!"
  },
  {
   "text": "Mom dropped the teapot.",
   "tag": "[dramatic]",
   "pause": 0.14
  },
  {
   "text": "He opened his ledger. A century ago, the first Matilda bought the whole harbor on credit.",
   "tag": "[storytelling]",
   "pause": 0.12
  },
  {
   "text": "Instead of paying, she made the town change names every year.",
   "tag": "[sly]",
   "pause": 0.12
  },
  {
   "text": "It wasn't a custom at all. Gullhaven was hiding from one bill.",
   "tag": "[revealing]",
   "pause": 0.14
  },
  {
   "text": "“With interest, you owe us the town. Three times.”",
   "tag": "[smug, pleased]",
   "pause": 0.14,
   "voice": "collector",
   "speak": "With interest, you owe us the town. Three times."
  },
  {
   "text": "Tilly licked her thumb and wiped her slate clean.",
   "tag": "[playful]",
   "pause": 0.12
  },
  {
   "text": "“Sorry, mister. Wrong house. I'm Brenda.”",
   "tag": "[sweet, innocent]",
   "pause": 0.12,
   "voice": "tilly",
   "speak": "Sorry, mister. Wrong house. I'm Brenda."
  },
  {
   "text": "And she shut the door.",
   "tag": "[satisfied]",
   "pause": 0.12
  }
 ],
 "samples": {
