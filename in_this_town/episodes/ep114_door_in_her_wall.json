 "lines": [
  {
   "text": "When you turn eleven, a door grows in your bedroom wall.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Behind it, a world built from whatever you love most.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Never enter someone else's world uninvited. It keeps you as scenery.",
   "tag": "[serious]",
   "pause": 0.12
  },
  {
   "text": "Felix folds paper animals. His best friend Mae keeps every one.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Mae turned eleven first: a mint-green door, a brass padlock.",
   "tag": "[amazed]",
   "pause": 0.12
  },
  {
   "text": "Each night, she stayed in longer.",
   "tag": "[serious]",
   "pause": 0.12
  },
  {
   "text": "“Not yet, Felix. Stay out.”",
   "tag": "[firmly]",
   "pause": 0.16,
   "voice": "mae",
   "speak": "Not yet, Felix. Stay out."
  },
  {
   "text": "Felix's birthday: no door.",
   "tag": "[deadpan]",
   "pause": 0.12
  },
  {
   "text": "One night, her door hung open. He slipped in.",
   "tag": "[whispering]",
   "pause": 0.12
  },
  {
   "text": "Paper stars, a strawberry milk river, a board-game bridge.",
   "tag": "[excited]",
   "pause": 0.12
  },
  {
   "text": "Then his sneakers creaked. Wood, climbing his knees.",
   "tag": "[urgent]",
   "pause": 0.12
  },
  {
   "text": "The stars turned red. Paper foxes dove, his very first folds.",
   "tag": "[urgent]",
   "pause": 0.12
  },
  {
   "text": "He hid behind their blanket fort, by a wooden boy in Felix's yellow beanie.",
   "tag": "[urgent]",
   "pause": 0.12
  },
  {
   "text": "Mae built this world from what she loved most. Them.",
   "tag": "[realizing]",
   "pause": 0.12
  },
  {
   "text": "“I'm not a burglar! This is my fort!”",
   "tag": "[determined]",
   "pause": 0.16,
   "voice": "felix",
   "speak": "I'm not a burglar! This is my fort!"
  },
  {
   "text": "The foxes froze. The wood crumbled like sawdust.",
   "tag": "[amazed]",
   "pause": 0.12
  },
  {
   "text": "“Your door was never coming. So I was building you half of mine.”",
   "tag": "[out of breath]",
   "pause": 0.16,
   "voice": "mae",
   "speak": "Your door was never coming. So I was building you half of mine."
  },
  {
   "text": "Now her door has a second key. It says Felix.",
   "tag": "[warm]",
   "pause": 0.12
  }
 ],
 "samples": {
