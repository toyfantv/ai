 "lines": [
  {
   "text": "In this town, every house moves at midnight.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "Nobody knows how.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "But every morning, people wake up on a completely different street.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "The only rule is simple.",
   "tag": "[serious]",
   "pause": 0.32
  },
  {
   "text": "Never look outside while your house is moving.",
   "tag": "[ominous]",
   "pause": 0.6
  },
  {
   "text": "One night, a boy named Ethan heard something scratching against his bedroom window.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "He checked the clock.",
   "tag": "[quietly]",
   "pause": 0.32
  },
  {
   "text": "12:01 AM.",
   "speak": "Twelve oh one, A.M.",
   "tag": "[tense]",
   "pause": 0.45
  },
  {
   "text": "Curious, he slowly opened the curtains.",
   "tag": "[slowly]",
   "pause": 0.5
  },
  {
   "text": "His house was floating hundreds of feet above the ground.",
   "tag": "[amazed]",
   "pause": 0.32
  },
  {
   "text": "Below him, thousands of houses were walking on enormous spider-like legs.",
   "tag": "[in awe]",
   "pause": 0.5
  },
  {
   "text": "But then Ethan noticed something strange.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "One house wasn't moving.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "It was standing in the middle of an empty field.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "And every other house was slowly circling it.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "Suddenly, the stationary house opened its front door.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "A gigantic eye appeared inside.",
   "tag": "[fearful]",
   "pause": 0.5
  },
  {
   "text": "Every moving house stopped.",
   "tag": "[whispers]",
   "pause": 0.5
  },
  {
   "text": "Then Ethan heard a voice coming from beneath his floor.",
   "tag": "[scared, quietly]",
   "pause": 0.6
  },
  {
   "text": "“IT FOUND US.”",
   "speak": "It found us.",
   "voice": "floor",
   "tag": "[whispers, terrified]",
   "fx": "giant",
   "pause": 0.6
  },
  {
   "text": "And his house started running.",
   "tag": "[dramatic]",
   "pause": 0.0
  }
 ],
