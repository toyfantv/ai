 "lines": [
  {
   "text": "In this town, clouds are living creatures.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "They sleep above the rooftops.",
   "tag": "[softly]",
   "pause": 0.32
  },
  {
   "text": "They eat sunlight.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "And sometimes, they follow people home.",
   "tag": "[warmly]",
   "pause": 0.32
  },
  {
   "text": "Everyone has their own cloud.",
   "tag": "[warmly]",
   "pause": 0.4
  },
  {
   "text": "But there's one rule.",
   "tag": "[serious]",
   "pause": 0.32
  },
  {
   "text": "Never let your cloud touch the ground.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "A girl named Chloe had a tiny pink cloud that followed her everywhere.",
   "tag": "[warmly]",
   "pause": 0.32
  },
  {
   "text": "Until one morning, it started growing.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "By lunchtime, it was bigger than her house.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "By sunset, it covered the entire neighborhood.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "Then it began descending.",
   "tag": "[ominous]",
   "pause": 0.4
  },
  {
   "text": "Chloe ran outside and shouted for it to stop.",
   "tag": "[urgent]",
   "pause": 0.32
  },
  {
   "text": "But the cloud kept falling.",
   "tag": "[fearful]",
   "pause": 0.4
  },
  {
   "text": "The moment it touched the street, the ground began shaking.",
   "tag": "[dramatic]",
   "pause": 0.4
  },
  {
   "text": "A gigantic mouth opened inside the cloud.",
   "tag": "[fearful]",
   "pause": 0.32
  },
  {
   "text": "And it whispered,",
   "tag": "[whispers]",
   "pause": 0.3
  },
  {
   "text": "“Thank you for raising me.”",
   "speak": "Thank you for raising me.",
   "voice": "cloud",
   "tag": "[whispers, gentle]",
   "fx": "giant",
   "pause": 0.5
  },
  {
   "text": "Suddenly, every cloud in the sky opened its eyes.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "They weren't clouds.",
   "tag": "[shocked]",
   "pause": 0.32
  },
  {
   "text": "They were babies.",
   "tag": "[shocked]",
   "pause": 0.5
  },
  {
   "text": "And their mother was coming to collect them.",
   "tag": "[whispers, terrified]",
   "pause": 0.0
  }
 ],
