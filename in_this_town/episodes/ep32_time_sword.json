 "lines": [
  {
   "text": "Rowan found the sword buried beneath a ruined island.",
   "tag": "[mysterious]",
   "pause": 0.08
  },
  {
   "text": "Its blade was completely black.",
   "tag": "[softly]",
   "pause": 0.09
  },
  {
   "text": "The moment he touched it, every clock stopped.",
   "tag": "[mysterious]",
   "pause": 0.13
  },
  {
   "text": "A voice whispered,",
   "tag": "[softly]",
   "pause": 0.05
  },
  {
   "text": "“He's coming.”",
   "tag": "[whispers]",
   "pause": 0.09,
   "speak": "He's coming...",
   "voice": "whisper",
   "fx": "whisper"
  },
  {
   "text": "The ocean split apart.",
   "tag": "[serious]",
   "pause": 0.09
  },
  {
   "text": "An armored swordsman rose from the water.",
   "tag": "[mysterious]",
   "pause": 0.09
  },
  {
   "text": "Without warning, he attacked.",
   "tag": "[serious]",
   "pause": 0.08
  },
  {
   "text": "Rowan barely blocked the first strike.",
   "tag": "[excited]",
   "pause": 0.06
  },
  {
   "text": "The second shattered the ground beneath him.",
   "tag": "[excited]",
   "pause": 0.06
  },
  {
   "text": "The third sent him flying through a stone wall.",
   "tag": "[excited]",
   "pause": 0.13
  },
  {
   "text": "Rowan stood, bleeding from a small cut above his eyebrow.",
   "tag": "[serious]",
   "pause": 0.09
  },
  {
   "text": "The swordsman raised his glowing blade.",
   "tag": "[serious]",
   "pause": 0.07
  },
  {
   "text": "The entire island froze.",
   "tag": "[mysterious]",
   "pause": 0.18
  },
  {
   "text": "Everything stopped.",
   "tag": "[softly]",
   "pause": 0.08
  },
  {
   "text": "Except Rowan.",
   "tag": "[softly]",
   "pause": 0.15
  },
  {
   "text": "He looked at his black sword. Then swung it through the air.",
   "tag": "[slowly]",
   "pause": 0.13,
   "speak": "He looked at his black sword... Then swung it through the air."
  },
  {
   "text": "A glowing crack opened in time.",
   "tag": "[mysterious]",
   "pause": 0.11
  },
  {
   "text": "Rowan could see every attack before it happened.",
   "tag": "[excited]",
   "pause": 0.07
  },
  {
   "text": "He dodged.",
   "tag": "[excited]",
   "pause": 0.05
  },
  {
   "text": "Countered.",
   "tag": "[excited]",
   "pause": 0.05
  },
  {
   "text": "And struck the swordsman across the chest.",
   "tag": "[excited]",
   "pause": 0.13
  },
  {
   "text": "The armor shattered.",
   "tag": "[serious]",
   "pause": 0.09
  },
  {
   "text": "But underneath was nobody.",
   "tag": "[softly]",
   "pause": 0.09
  },
  {
   "text": "Only darkness.",
   "tag": "[whispers]",
   "pause": 0.15
  },
  {
   "text": "A voice echoed from the empty helmet.",
   "tag": "[mysterious]",
   "pause": 0.07
  },
  {
   "text": "“You've finally learned.”",
   "tag": "[slowly]",
   "pause": 0.18,
   "speak": "You've finally learned.",
   "voice": "helmet",
   "fx": "helmet"
  },
  {
   "text": "Rowan looked at his reflection in the blade.",
   "tag": "[calm]",
   "pause": 0.08,
   "speak": "Rowan looked at his reflection, in the blade."
  },
  {
   "text": "He was wearing the armor.",
   "tag": "[softly]",
   "pause": 0.18
  },
  {
   "text": "Beneath the island, thousands of identical swords began waking up.",
   "tag": "[mysterious]",
   "pause": 0.07
  }
 ],
