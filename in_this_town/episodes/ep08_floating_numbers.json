 "lines": [
  {
   "text": "In this town, everyone has a number floating above their head.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "Nobody knows what the numbers mean.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "Some people have millions.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "Others have only a few hundred.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "But the numbers decrease every single day.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "A girl named Sophie had always been curious about hers.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "Until one morning, she woke up with the number one.",
   "tag": "[tense]",
   "pause": 0.7
  },
  {
   "text": "She panicked.",
   "tag": "[alarmed]",
   "pause": 0.32
  },
  {
   "text": "She thought it meant she had one day left to live.",
   "tag": "[fearful]",
   "pause": 0.32
  },
  {
   "text": "So she locked herself inside her house.",
   "tag": "[urgent]",
   "pause": 0.5
  },
  {
   "text": "But at midnight, something strange happened.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "Her number changed to zero.",
   "tag": "[tense]",
   "pause": 0.8
  },
  {
   "text": "And she didn't disappear.",
   "tag": "[surprised]",
   "pause": 0.4
  },
  {
   "text": "Instead, every person in town suddenly turned toward her.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "Their numbers vanished.",
   "tag": "[quietly]",
   "pause": 0.4
  },
  {
   "text": "Then a message appeared across the sky.",
   "tag": "[tense]",
   "pause": 0.8
  },
  {
   "text": "“THE LAST REAL PERSON HAS BEEN IDENTIFIED.”",
   "speak": "The last real person has been identified.",
   "voice": "system",
   "tag": "[robotic, flat]",
   "fx": "radio",
   "pause": 0.8
  },
  {
   "text": "Sophie looked around.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "Every neighbor was smiling.",
   "tag": "[eerie]",
   "pause": 0.4
  },
  {
   "text": "Then their faces began glitching.",
   "tag": "[fearful]",
   "pause": 0.5
  },
  {
   "text": "And the entire town started disappearing.",
   "tag": "[dramatic]",
   "pause": 1.0
  },
  {
   "text": "Except Sophie.",
   "tag": "[whispers]",
   "pause": 0.0
  }
 ],
