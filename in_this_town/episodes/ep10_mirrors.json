 "lines": [
  {
   "text": "In this town, mirrors don't show your reflection.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "They show what you'll be doing tomorrow.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "People use them to prepare for their future.",
   "tag": "[calm]",
   "pause": 0.32
  },
  {
   "text": "But there's one rule.",
   "tag": "[serious]",
   "pause": 0.32
  },
  {
   "text": "Never look into a broken mirror.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "A girl named Ava accidentally dropped her bedroom mirror.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "It shattered into hundreds of pieces.",
   "tag": "[dramatic]",
   "pause": 0.4
  },
  {
   "text": "And in every piece, she saw herself.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "But each reflection was doing something different.",
   "tag": "[uneasy]",
   "pause": 0.32
  },
  {
   "text": "One was crying.",
   "tag": "[quietly]",
   "pause": 0.32
  },
  {
   "text": "Another was running.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "And one was standing completely still.",
   "tag": "[slowly]",
   "pause": 0.4
  },
  {
   "text": "Smiling.",
   "tag": "[whispers]",
   "pause": 0.5
  },
  {
   "text": "Then every reflection suddenly looked directly at her.",
   "tag": "[fearful]",
   "pause": 0.32
  },
  {
   "text": "All except one.",
   "tag": "[quietly]",
   "pause": 0.32
  },
  {
   "text": "That reflection was pointing behind her.",
   "tag": "[ominous]",
   "pause": 0.5
  },
  {
   "text": "Ava slowly turned around.",
   "tag": "[slowly, scared]",
   "pause": 0.32
  },
  {
   "text": "Nobody was there.",
   "tag": "[whispers]",
   "pause": 0.4
  },
  {
   "text": "When she looked back, every reflection had disappeared.",
   "tag": "[fearful]",
   "pause": 0.32
  },
  {
   "text": "Except the smiling one.",
   "tag": "[ominous]",
   "pause": 0.4
  },
  {
   "text": "It pressed its hand against the glass.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "And whispered,",
   "tag": "[whispers]",
   "pause": 0.4
  },
  {
   "text": "“Tomorrow is already here.”",
   "speak": "Tomorrow is already here.",
   "voice": "reflection",
   "tag": "[whispers, eerie]",
   "fx": "whisper",
   "pause": 0.6
  },
  {
   "text": "Then the reflection stepped out.",
   "tag": "[dramatic, fearful]",
   "pause": 0.0
  }
 ],
