 "lines": [
  {
   "text": "Hurt someone in Larkspur, and a flower sprouts from your skin.",
   "tag": "[warm]",
   "pause": 0.14
  },
  {
   "text": "Forget a birthday? A buttercup on your thumb.",
   "tag": "[playful]",
   "pause": 0.12
  },
  {
   "text": "Break a heart? A thistle across your cheek.",
   "tag": "[calm]",
   "pause": 0.12
  },
  {
   "text": "Only a real sorry, truly forgiven, makes it drop.",
   "tag": "[calm]",
   "pause": 0.14
  },
  {
   "text": "Nell, the bakery girl, had never grown one petal.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Mr. Hollis wore black dahlias, collar to fingertips.",
   "speak": "Mister Hollis wore black dahlias, collar to fingertips.",
   "tag": "[mysterious]",
   "pause": 0.1
  },
  {
   "text": "Nobody went near him.",
   "tag": "[softly]",
   "pause": 0.14
  },
  {
   "text": "One windy Monday, her bread cart got loose and smashed his greenhouse.",
   "tag": "[excited]",
   "pause": 0.1
  },
  {
   "text": "“I'm so sorry!”",
   "speak": "I'm so sorry!",
   "voice": "nell",
   "tag": "[panicked]",
   "pause": 0.1
  },
  {
   "text": "She checked her arms. Nothing grew.",
   "tag": "[curious]",
   "pause": 0.12
  },
  {
   "text": "“It's only glass.”",
   "speak": "It's only glass.",
   "voice": "hollis",
   "tag": "[flatly]",
   "pause": 0.12
  },
  {
   "text": "A flower needs a wound. He had nothing left to wound.",
   "tag": "[softly]",
   "pause": 0.14
  },
  {
   "text": "A week later, she asked.",
   "tag": "[calm]",
   "pause": 0.08
  },
  {
   "text": "“Who did you hurt?”",
   "speak": "Who did you hurt?",
   "voice": "nell",
   "tag": "[quietly]",
   "pause": 0.1
  },
  {
   "text": "A buttercup popped up on her thumb.",
   "tag": "[playful]",
   "pause": 0.12
  },
  {
   "text": "“Nobody.”",
   "speak": "Nobody.",
   "voice": "hollis",
   "tag": "[softly]",
   "pause": 0.14
  },
  {
   "text": "He folded back his cuff. The roots ran inward.",
   "tag": "[mysterious]",
   "pause": 0.14
  },
  {
   "text": "“My Ruth was dying, and the pain made her cruel.”",
   "speak": "My Ruth was dying, and the pain made her cruel.",
   "voice": "hollis",
   "tag": "[sadly]",
   "pause": 0.12
  },
  {
   "text": "“So I took her flowers. She left clean.”",
   "speak": "So I took her flowers. She left clean.",
   "voice": "hollis",
   "tag": "[softly]",
   "pause": 0.16
  },
  {
   "text": "Not one bloom was his.",
   "tag": "[softly]",
   "pause": 0.2
  },
  {
   "text": "Nell touched the blackest dahlia.",
   "tag": "[softly]",
   "pause": 0.12
  },
  {
   "text": "“I forgive her.”",
   "speak": "I forgive her.",
   "voice": "nell",
   "tag": "[softly]",
   "pause": 0.16
  },
  {
   "text": "It crumbled, and blew away.",
   "tag": "[warm]",
   "pause": 0.14
  },
  {
   "text": "Nell ran for town.",
   "tag": "[excited]",
   "pause": 0.14
  },
  {
   "text": "By morning, the whole street lined up at his gate.",
   "tag": "[warm]",
   "pause": 0.2
  }
 ],
