 "lines": [
  {
   "text": "In Fernbrook, every thank-you said to your face makes you an inch taller.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Crossing guards duck under streetlights. Greedy people stay pocket-sized.",
   "tag": "[amused]",
   "pause": 0.12,
   "speak": "Crossing guards duck under streetlights, and greedy people stay pocket-sized."
  },
  {
   "text": "Milo was thirteen and needed a stool to reach the fountain.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "Everyone called him selfish. Even his best friend June believed it.",
   "tag": "[serious]",
   "pause": 0.12
  },
  {
   "text": "But the school had a Phantom: tires pumped overnight, lost homework returned with a note.",
   "tag": "[curious]",
   "pause": 0.12
  },
  {
   "text": "Then June spotted bike grease on Milo's fingers.",
   "tag": "[suspicious]",
   "pause": 0.12
  },
  {
   "text": "She followed him behind the gym. He was fixing the new girl's bike chain.",
   "tag": "[whispering]",
   "pause": 0.12
  },
  {
   "text": "“It's you! You're the Phantom!”",
   "tag": "[excited]",
   "pause": 0.14,
   "voice": "june",
   "speak": "It's you! You're the Phantom!"
  },
  {
   "text": "His grandpa used to say, help that waits for a thank-you is just shopping.",
   "tag": "[warm]",
   "pause": 0.12
  },
  {
   "text": "So Milo helped unseen, and stayed small.",
   "tag": "[tender]",
   "pause": 0.12
  },
  {
   "text": "“Please don't tell anyone.”",
   "tag": "[pleading]",
   "pause": 0.14,
   "voice": "milo",
   "speak": "Please... don't tell anyone."
  },
  {
   "text": "June didn't tell. She hung a giant photo over the front doors.",
   "tag": "[playful]",
   "pause": 0.12
  },
  {
   "text": "“Thank you, Milo.”",
   "tag": "[sincere]",
   "pause": 0.14,
   "voice": "nadia",
   "speak": "Thank you, Milo."
  },
  {
   "text": "One inch. Then the flat-tire kid. The homework kid. A whole hallway of them.",
   "tag": "[excited]",
   "pause": 0.12
  },
  {
   "text": "Taller than the principal, until his head bumped the lights.",
   "tag": "[amazed]",
   "pause": 0.12
  },
  {
   "text": "He knelt all the way down to June.",
   "tag": "[tender]",
   "pause": 0.12
  },
  {
   "text": "“You told them. Thank you, June.”",
   "tag": "[softly]",
   "pause": 0.14,
   "voice": "milo",
   "speak": "You told them... Thank you, June."
  },
  {
   "text": "And June grew one inch.",
   "tag": "[warm]",
   "pause": 0.12
  }
 ],
