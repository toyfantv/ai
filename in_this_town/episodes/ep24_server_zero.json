 "lines": [
  {
   "text": "Oliver found a strange seed while digging in his Roblox garden.",
   "tag": "[curious]",
   "pause": 0.35,
   "audio": "build/ep24/local_lines/line_00.wav"
  },
  {
   "text": "It wasn't in the seed shop.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_01.wav"
  },
  {
   "text": "And nobody in the server knew what it was.",
   "tag": "[mysterious]",
   "pause": 0.4,
   "audio": "build/ep24/local_lines/line_02.wav"
  },
  {
   "text": "The seed was shaped like a tiny blue cube.",
   "tag": "[curious]",
   "pause": 0.35,
   "audio": "build/ep24/local_lines/line_03.wav"
  },
  {
   "text": "Oliver planted it anyway.",
   "tag": "[conversational]",
   "pause": 0.65,
   "audio": "build/ep24/local_lines/line_04.wav"
  },
  {
   "text": "Five minutes later, a glowing staircase grew out of the soil.",
   "tag": "[in awe]",
   "pause": 0.35,
   "audio": "build/ep24/local_lines/line_05.wav",
   "local": {
    "rate": 1.0
   }
  },
  {
   "text": "It stretched higher than the clouds.",
   "tag": "[in awe]",
   "pause": 0.55,
   "audio": "build/ep24/local_lines/line_06.wav"
  },
  {
   "text": "Oliver started climbing.",
   "tag": "[conversational]",
   "pause": 0.5,
   "audio": "build/ep24/local_lines/line_07.wav"
  },
  {
   "text": "At the top was a floating island.",
   "tag": "[in awe]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_08.wav"
  },
  {
   "text": "Covered in gardens.",
   "tag": "[in awe]",
   "pause": 0.35,
   "audio": "build/ep24/local_lines/line_09.wav"
  },
  {
   "text": "But every plant was made of glowing blue glass.",
   "tag": "[mysterious]",
   "pause": 0.45,
   "audio": "build/ep24/local_lines/line_10.wav",
   "local": {
    "rate": 1.0
   }
  },
  {
   "text": "There were no other players.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_11.wav"
  },
  {
   "text": "Just a wooden sign.",
   "tag": "[mysterious]",
   "pause": 0.5,
   "audio": "build/ep24/local_lines/line_12.wav"
  },
  {
   "text": "\"SERVER ZERO.\"",
   "tag": "[slowly]",
   "pause": 0.65,
   "speak": "Server zero.",
   "voice": "system",
   "audio": "build/ep24/local_lines/line_13.wav"
  },
  {
   "text": "Oliver explored the island.",
   "tag": "[conversational]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_14.wav"
  },
  {
   "text": "Then he found a giant tree with thousands of names carved into its trunk.",
   "tag": "[in awe]",
   "pause": 0.4,
   "audio": "build/ep24/local_lines/line_15.wav"
  },
  {
   "text": "Every name belonged to a player.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_16.wav",
   "local": {
    "rate": 1.0
   }
  },
  {
   "text": "Some were glowing.",
   "tag": "[mysterious]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_17.wav"
  },
  {
   "text": "Others had faded away.",
   "tag": "[softly]",
   "pause": 0.65,
   "audio": "build/ep24/local_lines/line_18.wav",
   "local": {
    "rate": 1.0
   }
  },
  {
   "text": "Suddenly, Oliver's own name appeared.",
   "tag": "[mysterious]",
   "pause": 0.4,
   "audio": "build/ep24/local_lines/line_19.wav"
  },
  {
   "text": "A small branch grew from the tree.",
   "tag": "[in awe]",
   "pause": 0.3,
   "audio": "build/ep24/local_lines/line_20.wav"
  },
  {
   "text": "And a glowing seed fell into his hand.",
   "tag": "[in awe]",
   "pause": 0.4,
   "audio": "build/ep24/local_lines/line_21.wav"
  },
  {
   "text": "A message appeared.",
   "tag": "[mysterious]",
   "pause": 0.4,
   "audio": "build/ep24/local_lines/line_22.wav"
  },
  {
   "text": "\"PLANT THIS WHERE SOMEONE HAS FORGOTTEN TO GROW.\"",
   "tag": "[slowly]",
   "pause": 0.7,
   "speak": "Plant this where someone has forgotten... to grow.",
   "voice": "system",
   "audio": "build/ep24/local_lines/line_23.wav",
   "local": {
    "rate": 1.0
   }
  },
  {
   "text": "When Oliver returned to his garden, every empty plot in town had begun blooming.",
   "tag": "[warm]",
   "pause": 0.4,
   "audio": "build/ep24/local_lines/line_24.wav",
   "local": {
    "src": "en_us_010"
   },
   "speak": "When Oliver returned to his garden, every, empty plot in town had begun blooming."
  }
 ],
