 "lines": [
  {
   "text": "In this town, everyone receives a mysterious package at midnight.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "Nobody knows who delivers them.",
   "tag": "[mysterious]",
   "pause": 0.32
  },
  {
   "text": "And there's only one rule.",
   "tag": "[serious]",
   "pause": 0.35
  },
  {
   "text": "Never open a package that has your own name written inside.",
   "tag": "[ominous]",
   "pause": 0.45
  },
  {
   "text": "One night, a girl named Emily heard three knocks at her front door.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "Outside was a small black box.",
   "tag": "[intrigued]",
   "pause": 0.32
  },
  {
   "text": "There was no return address.",
   "tag": "[uneasy]",
   "pause": 0.35
  },
  {
   "text": "She carefully opened it.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "Inside was a tiny model of her house.",
   "tag": "[in awe]",
   "pause": 0.32
  },
  {
   "text": "Every room looked exactly the same.",
   "tag": "[curious]",
   "pause": 0.32
  },
  {
   "text": "Even the furniture.",
   "tag": "[uneasy]",
   "pause": 0.4
  },
  {
   "text": "But then Emily noticed something strange.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "Inside the miniature bedroom was a tiny version of herself.",
   "tag": "[uneasy]",
   "pause": 0.35
  },
  {
   "text": "And it was moving.",
   "tag": "[whispers]",
   "pause": 0.45
  },
  {
   "text": "Emily watched as the tiny figure walked toward the bedroom window.",
   "tag": "[tense]",
   "pause": 0.32
  },
  {
   "text": "Then it looked directly up at her.",
   "tag": "[fearful]",
   "pause": 0.5
  },
  {
   "text": "Suddenly, the miniature house began shaking.",
   "tag": "[urgent]",
   "pause": 0.32
  },
  {
   "text": "A gigantic hand appeared outside its window.",
   "tag": "[fearful]",
   "pause": 0.35
  },
  {
   "text": "Emily screamed.",
   "tag": "[shocked]",
   "pause": 0.35
  },
  {
   "text": "Because the hand looked exactly like hers.",
   "tag": "[whispers, terrified]",
   "pause": 0.55
  },
  {
   "text": "Then she heard three knocks.",
   "tag": "[tense]",
   "pause": 0.4
  },
  {
   "text": "Not at her front door.",
   "tag": "[whispers]",
   "pause": 0.3
  },
  {
   "text": "But from somewhere above her house.",
   "tag": "[ominous]",
   "pause": 0.45
  },
  {
   "text": "And the entire sky began opening like a cardboard box.",
   "tag": "[in awe, terrified]",
   "pause": 0.0
  }
 ],
